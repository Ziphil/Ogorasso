"語根"],"number":2330,"spelling":"√ҫ-л-х"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"689ffafe4420597dd70bd91f","number":48,"spelling":"си̂м","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["食べ物","食物"],"termString":"食べ物, 食物","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1,"spelling":"√с-ъ-м"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"69eb30275e76fd30c59c6f79","number":628,"spelling":"си̂м","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["食べる"],"termString":"[Х を] 食べる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["食事する"],"termString":"[С の] 食事する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"{си̂ххас}「朝」, {ки̂шарре}「昼」, {зи̂ммаво}「夕方」などの与格形をとって、その時間での食事をとることを表す。\n例えば、 {си̂м ки̂шаррес} は「昼食をとる」の意味である。\n直近の食事について話す場合など特定の時間が想定されている場合は、これらの時間を表す単語は定形をとる。","hidden":false},{"title":"語法","text":"語義 A をさらに兼ねることはなく、与格目的語のみをとってその時間での食事をとることを表すか、対格目的語のみをとってそれを食べることを表すかのどちらかでしか使われない。\nそのため、例えば「朝食に *A* を食べる」は {си̂м *A* си̂ххасе} や {си̂м *A* дез си̂ххасревепи̂нта} 等で表現される。","hidden":false},{"title":"類義語","text":"⟪[{си̂м}](@#628), [{вепни̂т}](@#632)⟫\n「食事する」すなわち「まとまった食べ物を食べる」の意味では {си̂м} も {вепни̂т} も用いられ、格組も同様である。\nしかし、{си̂м} の方が少し口語的な印象がある。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":632,"spelling":"вепни̂т"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1,"spelling":"√с-ъ-м"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"69bcf14596764decc67d08ec","number":221,"spelling":"си̂мар","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["近い"],"termString":"[С に, М に] 近い","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["名詞","赤類"],"terms":["近く","近所"],"termString":"[С の, М の] 近く, 近所","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"どこを基準にして近いかは、与格でも奪格でも表される。\nどちらでもニュアンスの違いは特にない。\n与格の用法は対応する動詞の「～に近づく」から来ていて、奪格の用法は奪格が一般に基準を表すことから来ていると考えられる。","hidden":false},{"title":"語法","text":"名詞用法は、与格名詞や奪格名詞を伴って「(その場所から) 近くに位置する場所」を表す。\n項を伴わず定形で用いられた場合は「ここから近く」を意味する。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1484,"spelling":"си̂пал"},{"titles":["対義語"],"number":98,"spelling":"хи̂ват"}]},{"equivalents":[{"titles":["形容詞"],"terms":["安い","低額の"],"termString":"安い, 低額の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":98,"spelling":"хи̂ват"},{"titles":["対義語"],"number":2111,"spelling":"чебу̂бое"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":220,"spelling":"√с-м-р"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"69bf9ed274f48bfee8d83047","number":2121,"spelling":"си̂ммар","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["似ている","似た","類似の","類似する"],"termString":"[С に, М に] 似ている, 似た, 類似の, 類似する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":349,"spelling":"тефи̂чал"}]},{"equivalents":[{"titles":["連述詞"],"terms":["同じくらい"],"termString":"同じくらい","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":348,"spelling":"ти̂чал"}]},{"equivalents":[],"informations":[],"phrases":[],"vari