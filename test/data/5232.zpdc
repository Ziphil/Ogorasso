:35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"697eed0ce268e2c927939768","number":983,"spelling":"ӈу̂тто","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["首"],"termString":"首","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[{"titles":[],"expression":"валу̂кке ӈу̂тта","terms":["首を絞める","絞首する"],"termString":"首を絞める, 絞首する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","text":"","hidden":false}],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":940,"spelling":"√ӈ-л-т"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"689ffbe14420597dd70c25cd","number":461,"spelling":"ӈу̂чо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["変な","奇妙な","不自然な"],"termString":"変な, 奇妙な, 不自然な","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":224,"spelling":"√ӈ-ч-ў"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"696a3beac1c857548d7918e9","number":225,"spelling":"ӈу̂чое","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["7 個","7 人","7 つ"],"termString":"7 個, 7 人, 7 つ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["形容詞"],"terms":["7"],"termString":"7","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":224,"spelling":"√ӈ-ч-ў"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"}]}]},{"id":"69a26f96d9f0848b20b2ad35","number":311,"spelling":"‹-ак-›","pronunciation":"","tags":["語型接辞"],"sections":[{"equivalents":[{"titles":["接辞"],"terms":["されるもの","するもの"],"termString":"～されるもの, ～するもの","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"用言からそれに直接的に関連する名詞的な体言を作る。\nほとんどの場合で、動詞の目的語に相当する体言が作られる。\n例えば、{чаҕи̂с}「伝える」からは {чаҕи̂ско}「お知らせ」が作られるが、これは「伝える」の対格目的語に相当する名詞である。\n用言と語型の種類が同じ体言も意味的に関連してはいるが、⁎{-ак-} による派生で生じた名詞の方がより動詞の意味を保つ。","hidden":false},{"title":"語法","text":"他の接辞の場合とは異なり、⁎{-ак-} によって用言から作られた名詞の類には以下に述べる明確な規則がある。\n⁎{-ак-} が付いた名詞が具体的なものを指すものである場合は、その類は赤類になる。\n⁎{-ак-} が付いた名詞が内容をもつようないわゆるコト名詞である場合は、その類は青類になる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["接辞"],"terms":["の感情"],"termString":"～の感情","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"ある感情をもつことを表す用言に付いて、その感情そのものを表す。\nこれによって派生した名詞は赤類になる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["接辞"],"terms":["の尺度","の度合い","のレベル"],"termString":"～の尺度, ～の度合い, ～のレベル","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"この意味で派生した名詞は原則赤類になる。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"69426c59ca55dc2acf01ae13","number":1074,"spelling":"‹-ал-›","pronunciation":"","tags":["語型接辞"],"sections":[{"equivalents":[{"titles":["接辞"],"terms":["すること"],"termString":"～すること","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"用言の不定詞形を作る。\n\n通常、この語形変化は活用の一種として扱われるので、独立した単語とは見なされない。\nしかし、不定詞が単なる「～すること」という意味から少し離れて独立した名詞の用法を獲得していると考えられる場合は、語型接辞 ⁎{-ал-} が付加された体言と見なして立項することにしてある。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"69426c4cca55dc2acf01ac6e","number":1075,"spelling":"‹-ар-›","pronunciation":"","tags":["語型接辞"],"sections":[{"equivalents":[{"titles":["接辞"],"terms":["している"],"termString":"～している","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"用言の分詞形や体言の形容詞形を作る。\n\n通常、この語形変化は活用の一種として扱われるので、独立した単語とは見なされない。\nしかし、分詞や形容詞が単なる「～している」や「～に関連する」という意味から少し離れて独立した用法を獲得していると考えられる場合は、語型接辞 ⁎{-ар-} が付加された体言と見なして立項することにしてある。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["接辞"],"terms":["的な","に関連する"],"termString":"～的な, ～に関連する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"名詞的な体言から形容詞的な体言を作る。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"6981b3264f437f8b935a7b17","number":600,"spelling":"‹-еб-›","pronunciation":"","tags":["語型接辞"],"sections":[{"equivalents":[{"titles":["接辞"],"terms":["のある","の多い"],"termString":"～のある, ～の多い","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"⁎[{-оӝ-}](@#143) と対になって対義語を作ることも多い。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1223,"spelling":"‹беза-›"},{"titles":["対義語"],"number":143,"spelling":"‹-оӝ-›"}]},{"equivalents":[{"titles":["接辞"],"terms":["できる"],"termString":"～できる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"⁎[{-оӝ-}](@#143) と対になって対義語を作ることも多い。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":143,"spelling":"‹-оӝ-›"}]}]},{"id":"68c88e20006049e77bd39454","number":65,"spelling":"‹-ед-›","pronunciation":"","tags":["語型接辞"],"sections":[{"equivalents":[{"titles":["接辞"],"terms":["の場所","の施設"],"termString":"～の場所, ～の施設","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"関連する場所や施設を表す。\n単語によっては、ある動作を行うために設置して使うタイプの道具を表すこともある。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["接辞"],"terms":["の催し"],"termString":"～の催し","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]}]},{"id":"68654eb7bf79b0951fa6753f","number":200,"spelling":"‹-ес-›","pronunciation":"","tags":["語型接辞"],"sections