法","text":"指大辞として働き、サイズや規模などが大きいことを表す。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["接辞"],"terms":["の集まり"],"termString":"～の集まり","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]}]},{"id":"68c88e32006049e77bd396d7","number":433,"spelling":"‹-од-›","pronunciation":"","tags":["語型接辞"],"sections":[{"equivalents":[{"titles":["接辞"],"terms":["の時間"],"termString":"～の時間","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"関連する時間を表す。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["接辞"],"terms":["の機会"],"termString":"～の機会","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]}]},{"id":"68654eb2bf79b0951fa674f5","number":746,"spelling":"‹-ос-›","pronunciation":"","tags":["語型接辞"],"sections":[{"equivalents":[{"titles":["接辞"],"terms":["するもの"],"termString":"～するもの","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]}]},{"id":"6981b3564f437f8b935a95a5","number":143,"spelling":"‹-оӝ-›","pronunciation":"","tags":["語型接辞"],"sections":[{"equivalents":[{"titles":["接辞"],"terms":["のない","でない"],"termString":"～のない, ～でない","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":600,"spelling":"‹-еб-›"}]},{"equivalents":[{"titles":["接辞"],"terms":["できない"],"termString":"～できない","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":600,"spelling":"‹-еб-›"}]},{"equivalents":[{"titles":["接辞"],"terms":["の逆"],"termString":"～の逆","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]}]},{"id":"68a046a74420597dd7110f01","nu