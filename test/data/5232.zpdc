、 *B* を基準に *A* の方へ 30° ずらした方角を指す。\n例えば {зеди̂ммаврокеду̂шро} は、 南を基準に西へ 30° ずれた方角を指すので、北を 12 時としたときの 7 時の方向を指す。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["合成元"],"number":117,"spelling":"ку̂шро"},{"titles":["合成元"],"number":1397,"spelling":"ли̂ссо"}]}]},{"id":"697fe8cd57355e8c954a6e4c","number":896,"spelling":"ку̂шрарофегу̂жанно","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["日傘","パラソル"],"termString":"日傘, パラソル","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"分離形","spelling":"фегу̂жанно ку̂шраро","pronunciation":""}],"relations":[{"titles":["合成元"],"number":117,"spelling":"ку̂шро"},{"titles":["合成元"],"number":894,"spelling":"фегу̂жанно"}]}]},{"id":"689ffadd4420597dd70bba76","number":117,"spelling":"ку̂шро","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["太陽","日"],"termString":"太陽, 日","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":116,"spelling":"√к-ш-р"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"697f4465e268e2c9279b044d","number":1600,"spelling":"ку̂ҕаж","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["中心","中心部","中央","真ん中"],"termString":"中心, 中心部, 中央, 真ん中","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1598,"spelling":"√к-ҕ-ж"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"69681f5e13a7efb23f