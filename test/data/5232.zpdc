\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true}],"informations":[{"title":"類義語","text":"⟪[{фешу̂лах}](@#2393), [{фебу̂жамме}](@#2404)⟫\n{фешу̂лах} は光に注目する言い方で、{фебу̂жамме} は熱さや温かさに注目する言い方である。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":2404,"spelling":"фебу̂жамме"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":54,"spelling":"√ш-л-х"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"}]}]},{"id":"698e841d3aa998141bd40462","number":1898,"spelling":"феҕи̂ссад","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["電話","電話機","テレフォン"],"termString":"電話, 電話機, テレフォン","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"機械全体を指す場合は、固定電話機もしくは電話機能が主な携帯端末のみを指す。\nスマートフォンは [{аллу̂цаз}](@#1212) と言う。\nただし、コンピュータ内の通話アプリを指すこともあり、この意味でスマートフォン内のアプリを指すことはある。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1896,"spelling":"√ҕ-с-д"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"}]}]},{"id":"69ae1f99ff6bee0e7c629000","number":2043,"spelling":"фи̂ддан","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["副詞","K 型"],"terms":["まだ","いまだ","なお"],"termString":"まだ, いまだ, なお","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"肯定でも否定でも用いられる。\n肯定節で使われれば「それをやめずにまだ続けている」の意味になり、否定節で使われば「それをせずにしていない状態をまだ続けている」の意味になる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2041,"spelling":"√ф-д-н"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"6981afe34f437f8b935a0cca","number":258,"spelling":"фи̂лан","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["新しい","新規の","次の"],"termString":"新しい, 新規の, 次の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{фи̂лан}](@#258), [{ху̂кке}](@#1499)⟫\n{фи̂лан} は、何らかの意味で被修飾語が成立してからの時間が少ないことを表す。\n{ху̂кке} は、そのものが存在し始めてからの時間が少ないことを表す。\n例えば {хо̂к фи̂лан} という表現は、最近子供が産まれるなどして親となった人や、子供目線で再婚等により親が変わった場合における新たな親などを指す。\nどちらも、視点は異なるものの、親になったときが「成立」の瞬間だと捉えられている。\n一方 {хо̂к ху̂кке} は、親であってその年齢が若い人を指す。\nまた、{но̂сат фи̂лан} は、購入者目線で買ってすぐの服や、第三者目線でその人が着ているのを初めて見た服などを指す。\nしかし {но̂сат ху̂кке} は、作りたての服を指す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1499,"spelling":"ху̂кке"},{"titles":["対義語"],"number":1498,"spelling":"зе̂ак"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":257,"spelling":"√ф-л-н"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"6a0284917d0bf8a267e2ec58","number":521,"spelling":"фи̂ллат","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["ウサギ"],"termString":"ウサギ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":[],"terms":["うさぎ","兎","兔","菟"],"termString":"うさぎ, 兎, 兔, 菟","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"旧綴り","spelling":"ки̂нах","pronunciation":""},{"title":"旧綴り","spelling":"рефу̂дде","pronunciation":""}],"relations":[{"titles":["語根"],"number":2383,"spelling":"√ф-л-т"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"69c5f8be2c4f1d2956592100","number":1188,"spelling":"фи̂лло","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["塵","微塵","粒子"],"termString":"塵, 微塵, 粒子","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"空気中に漂う小さな粒を表す。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","青類"],"terms":["花粉"],"termString":"花粉","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"より正確には [{и̂ххаррофи̂лло}](@#1189) と言うが、日常的には単にこちらが用いられることが多い。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1189,"spelling":"и̂ххарофу̂лло"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":992,"spelling":"√ў-с-л"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"695638917dbec3f28765d9d1","number":1654,"spelling":"фи̂ммас","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["普通の","通常の","一般の"],"termString":"普通の, 通常の, 一般の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":1534,"spelling":"и̂ггам"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1653,"spelling":"√ф-м-ҫ"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"689ffb6a4420597dd70bf2c9","number":40,"spelling":"фи̂на","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","両類"],"terms":["神","神様"],"termString":"神, 神様","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"両類名詞であるが、キリスト教やイスラム教のような一神教の神を指す際は、専ら青類形が使われる。\nギリシャ神話などの多神教の神を指す際は、その神の名前の形態やその神のイメージなどから類が選択される。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":38,"spelling":"√ф-н-ъ"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"699cf1654da6db8221a9db81","n