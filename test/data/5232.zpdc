ng":"но̀к","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["機能詞"],"terms":["か"],"termString":"～か","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"基本的に文頭に置かれて疑問文であることを明示する。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":198,"spelling":"на"}]}]},{"id":"698887f2e1b31cc9572bdfea","number":1871,"spelling":"но̀ч","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["機能詞"],"terms":["した"],"termString":"～した","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"動詞の直前に置かれ、その動作や状態が過去のものであることを表す。\nしかし、定形活用の動詞は過去時制形をとることでその時間が過去であることを明示できるので、この単語が現れるのは次の 2 つの場合のみである。\n1 つ目は、主節が過去時制である文の従属節において、従属節内の時間が主節よりも前であることを明確にするためである。\n2 つ目は、分詞や不定詞の時間がその節の時間よりも前であることを明確にするためである。\nどちらの場合も義務的ではなく、時間を明確にする目的がある場合にのみ用いられる。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"6982c849d7d80d747e0e964a","number":617,"spelling":"но̂ддо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["いつ"],"termString":"いつ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1847,"spelling":"анно̂ддо"}]}]},{"id":"6982c204d7d80d747e0e3f45","number":794,"spelling":"но̂с","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","両類"],"terms":["何","どれ","どのこと"],"termString":"何, どれ, どのこと","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1845,"spelling":"анно̂с"}]}]},{"id":"69e61371d1a028f54c7fd56e","number":2026,"spelling":"но̂ч","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["間投詞"],"terms":["ですよね","だよね","ですか","ではないですか","か"],"termString":"ですよね, だよね, ですか, ではないですか, か","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informatio