ca811","number":294,"spelling":"фегзу̂м","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["隠す"],"termString":"[Х を И に] 隠す","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["隠す","秘密にする"],"termString":"[Х を] 隠す, 秘密にする","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":277,"spelling":"√г-ӟ-м"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"}]}]},{"id":"699d0c0b4da6db8221ac4025","number":1959,"spelling":"фегзу̂мез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["隠れる"],"termString":"[И に] 隠れる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"人も物も主語になり得る。\n人が主語になった場合は、そのまま他の人に見つからないように身を隠すことを表す。\n物が主語になった場合は、見つかりづらい場所に置かれていることを表し、専ら完了相の意味で用いられる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":277,"spelling":"√г-ӟ-м"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"6981af7d4f437f8b935a02cf","number":894,"spelling":"фегу̂жанно","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["傘"],"termString":"傘","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"雨傘も日傘も指す。\n区別の必要がある場合は [{ду̂рзарофегу̂жанно}](@#895) と [{ку̂шрарофегу̂жанно}](@#896) が用いられる。","hidden":false}],"phrases":[{"titles":[],"expression":"фезлу̂е фегу̂жанна","terms":["傘を差す"],"termString":"傘を差す","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","text":"","hidden":false}],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":887,"spelling":"√г-ӝ-н"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"}]}]},{"id":"6981afae4f437f8b935a0653","number":760,"spelling":"фегу̂зам","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["隠された"],"termString":"隠された","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["形容詞"],"terms":["秘密の","内緒の","内密の"],"termString":"秘密の, 内緒の, 内密の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["名詞","青類"],"terms":["隠し事","秘密","内緒"],"termString":"隠し事, 秘密, 内緒","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["副詞","単純型"],"terms":["こっそり","密かに","内緒で"],"termString":"こっそり, 密かに, 内緒で","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{фегу̂зам}](@#760), [{зу̂ч}](@#757)⟫\n{фегу̂зам} と {зу̂ч} は、ともに「秘密の」や「秘密」を表し、大きな意味の違いはない。\nただし、{фегу̂зам} の方には「本人が意図的に隠している」というニュアンスが若干加わる。\nまた両者は、ともに「こっそり」という副詞に用法をもつが、この用法では今述べたニュアンスの違いが強まっており、{зу̂ч} には「誰にも気づかれずに」という含意があり、{фегу̂зам} には「誰にも言わずに」という含意がある。\nなお、「(物理的に物が) 隠されている」の意味は {фегу̂зам} にしかない。\n\n","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":757,"spelling":"зу̂ч"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":277,"spelling":"√г-ӟ-м"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"}]}]},{"id":"69f0858045269b763dd55d60","number":180,"spelling":"феди̂но","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["寺","寺院","神社","教会","礼拝堂","聖堂"],"termString":"寺, 寺院, 神社, 教会, 礼拝堂, 聖堂","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"あらゆる宗教施設を宗教の種類によらず指す。\n特定の宗教に属する施設を指す目的が特にある場合は、 [{жи̂нжа}](@#2297), [{те̂ра}](@#2298), [{и̂ҕлас}](@#2296), [{ме̂скат}](@#2299) 等の借用語が用いられる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":38,"spelling":"√ф-н-ъ"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]}]},{"id":"69a0fcc0b90b23af41acd87e","number":1987,"spelling":"феду̂нна","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["聖地","聖域","神域"],"termString":"聖地, 聖域, 神域","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":38,"spelling":"√ф-н-ъ"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]}]},{"id":"69bfbeaf74f48bfee8db4a58","number":1489,"spelling":"феду̂сак","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["フェドゥーサク"],"termString":"フェドゥーサク","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"フェンナ語正書法に特有の、下に線が引かれて周囲の文字から少し浮かせてが書かれた部分のことを表す。\n文字や記号が表音以外の目的で利用されている箇所や、他言語が (転写等がなされず) そのまま表記されている箇所に用いられる。\n特に数字は通常このスタイルで書かれる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["ルビ","振り仮名","読み仮名"],"termString":"ルビ, 振り仮名, 読み仮名","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":13,"spelling":"√д-с-к"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":418