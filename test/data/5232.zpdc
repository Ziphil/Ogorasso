ations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"旧綴り","spelling":"ту̂ду","pronunciation":""}],"relations":[{"titles":["語根"],"number":1950,"spelling":"√ӟ-д-н"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"697758a094ee2e3066c298e9","number":1793,"spelling":"зу̂с","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["自分","自身","自分自身"],"termString":"自分, 自身, 自分自身","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"対応するもの類に一致することはなく、常に赤類形で現れる。\nまた、対応するものはすでに文脈等で明らかになっているはずなので、原則として定形で現れる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1792,"spelling":"√ҙ-ў-с"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"69dda3a9a6ff07c10067544c","number":1591,"spelling":"зу̂хас","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["端","隅","角","末端","先端"],"termString":"端, 隅, 角, 末端, 先端","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"あるものの内部で局所的に中央から離れている箇所を指す。\n対象の形状の含意はなく、線状のものに対してはその両端を指し、平面や立体のものに対してはその隅を指す。","hidden":false},{"title":"類義語","text":"⟪[{зу̂хас}](@#1591), [{ги̂баш}](@#1045), [{ти̂ссач}](@#2225)⟫\n{зу̂хас} は、平面や立体の内部でその中央から局所的に最も離れている箇所を指す。\n対象の形状の含意はないが、円状のもののような隅がそもそも考えづらいものに対しては使われない。\n{ги̂баш} は、尖ったものや細長いものの端を指す。\nそのようなものの先端はたいてい中央から離れている箇所になるため、{ги̂баш} は {зу̂хас} の下位語とも捉えることができる。\nこれら 2 つの単語は、共通して対象の内部から見た一部分を指しているというニュアンスがある。\n一方で {ти̂ссач} は、対象を外側から見たときの出っ張った部分を指す。\n多角柱のような形をしたものの尖っている部分が典型例だが、コップの縁のような箇所も指す。\n例えば、「机の角にコップを置いた」という状況での「角」は {зу̂хас} であり、「机の角に手をぶつけた」という状況の「角」は {ти̂ссач} である。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1045,"spelling":"ги̂баш"},{"titles":["類義語"],"number":2225,"spelling":"ти̂ссач"}]},{"equivalents":[{"titles":["形容詞"],"terms":["極端な","極度な"],"termString":"極端な, 極度な","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["連述詞"],"terms":["極端に","極度に"],"termString":"極端に, 極度に","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1443,"spelling":"гу̂бач"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"旧綴り","spelling":"сецу̂т","pronunciation":""}],"relations":[{"titles":["語根"],"number":2049,"spelling":"√ҙ-х-ҫ"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"689ffad54420597dd70bb44b","number":757,"spelling":"зу̂ч","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["秘密","内緒"],"termString":"秘密, 内緒","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false},{"titles":["形容詞"],"terms":["秘密の","内緒の","内密の"],"termString":"秘密の, 内緒の, 内密の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false},{"titles":["副詞","単純型"],"terms":["内緒で","密かに","こっそり"],"termString":"内緒で, 密かに, こっそり","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":760,"spelling":"фегу̂зам"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":756,"spelling":"√з-ў-ч"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"69b67808ddf85d5456db1417","number":149,"spelling":"зу̂ӈ","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["深い"],"termString":"深い","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["名詞","赤類"],"terms":["深い場所","底","深淵"],"termString":"深い場所, 底, 深淵","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":1168,"spelling":"боҕи̂жас"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"旧綴り","spelling":"бу̂маҕ","pronunciation":""}],"relations":[{"titles":["語根"],"number":2083,"spelling":"√ӟ-ъ-ӈ"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"69e779cb2491c89064a8305d","number":2271,"spelling":"зузу̂ц","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["無視する","ないものとする"],"termString":"[Х を] 無視する, ないものとする","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["貯める","貯蔵する","蓄える"],"termString":"[Х を] 貯める, 貯蔵する, 蓄える","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":2013,"spelling":"дазе̂е"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":317,"spelling":"√ў-з-ц"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":291,"spelling":"‹зо-›"}]}]},{"id":"69b00d7bd2459d59e703ab07","number":276,"spelling":"ѝ","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["この"],"termString":"この","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["形容詞"],"terms":["今の"],"termString":"今の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"時間を表す表現を修飾して、現在を含むその期間を表す。\n例えば {ѝ лели̂ккасо} は、「現在を含む月」すなわち「今月」を表す。\nここで、英語の this とは違い、今日を含むその期間を表すことはないことに注意せよ。\n例えば {ѝ лези̂ммаво} という表現は、現在が夕方であればその「今の夕方」を指すが、一般に「今日の夕方」や「今晩」の意味にはならない。\n今日を含む期間は、{веки̂шшар} を明示的に用いて {лези̂ммаво левки̂шшарев} と表現される。","hidden":false}],"phrases":[],"variations":[],"relati