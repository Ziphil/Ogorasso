,{"id":"69a0f069b90b23af41ac3628","number":724,"spelling":"севи̂сах","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["奥","奥側","深部"],"termString":"[Е の, М の] 奥, 奥側, 深部","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"何の内側かは、奪格でも主格でも表される。\n格によって大きなニュアンスの違いはないが、主格が用いられた場合の方が「一部としての内側」という意味合いが若干強い。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":899,"spelling":"ми̂цак"}]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["果て","終わり"],"termString":"[Е の] 果て, 終わり","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"広い空間や範囲の中で、入口などの容易に進入できる点から遠い場所を表す。\n「辿り着くのが難しい」というニュアンスを含む。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["収納箱","宝箱"],"termString":"収納箱, 宝箱","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"大事なものや秘密のものを隠す目的で使われる容器を指す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1403,"spelling":"ви̂зац"}]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["へそくり","貯金","隠し財産"],"termString":"へそくり, 貯金, 隠し財産","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":288,"spelling":"√в-ҫ-х"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":188,"spelling":"‹ҫе-›"}]}]},{"id":"6a0435853fcdc929d67045d1","number":388,"spelling":"севли̂к","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["向く","面する","顔を向ける"],"termString":"[С を] 向く, 面する, 顔を向ける","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["向く","面する"],"termString":"[С を] (部屋が) 向く, 面する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"完了相の意味で用いられて、部屋などの向きを表す。\nただし、この意味では 〈{е̂к} ＋ 方角を表す名詞の連体与格形〉 という形も用いられ、{севли̂к} が使われないことも多い。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":386,"spelling":"√в-л-к"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":188,"spelling":"‹ҫе-›"}]}]},{"id":"6a04349a3fcdc929d6702826","number":2394,"spelling":"севли̂кар","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["向きの","向いている"],"termString":"[ВС を] (部屋などが) 向きの, 向いている","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"{севли̂к} の分詞であるが、この意味では通常の形容詞のように扱われるため、方角を表す名詞は連体形をとる。","hidden":false},{"title":"語法","text":"〈部屋などを表す単語 ＋ 方角を表す単語の連体与格形〉 の形でも「～向きの」が表されるため、 {севли̂кар} が明示的に使われることはそれほど多くない。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":386,"spelling":"√в-л-к"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":188,"spelling":"‹ҫе-›"},{"titles":["語型"],"number":1075,"spelling":"‹-ар-›"}]}]},{"id":"693ebd3ef2aa5984aea578e8","number":1512,"spelling":"севси̂х","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["しまう"],"termString":"[Х を] しまう","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":976,"spelling":"вози̂ц"}]},{"equivalents":[{"titles":["動詞"],"terms":["封じる","封じ込める","閉じ込める"],"termString":"[Х を С に] 封じる, 封じ込める, 閉じ込める","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語義","text":"対象が外に出ないように、比較的狭い空間や範囲にあり続けさせることを表す。\n基本的に、目的語には「噂」や「病気」などのネガティブなニュアンスの単語が置かれる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":288,"spelling":"√в-ҫ-х"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":188,"spelling":"‹ҫе-›"}]}]},{"id":"69e0364760f7790b751d03e5","number":2241,"spelling":"севси̂хар","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["おとなしい","控えめな"],"termString":"おとなしい, 控えめな","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"自分の感情をあまり表に出さない性格を表す。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":288,"spelling":"√в-ҫ-х"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":188,"spelling":"‹ҫе-›"},{"titles":["語型"],"number":1075,"spelling":"‹-ар-›"}]}]},{"id":"69ae7358ff6bee0e7c6896f7","number":729,"spelling":"сегви̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["辿り着く","到達する","達する"],"termString":"[С に] 辿り着く, 到達する, 達する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":[],"terms":["たどり着く"],"termString":"たどり着く","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":2050,"spelling":"заххи̂с"}]},{"equivalents":[{"titles":["動詞"],"terms":["成し遂げる","やり遂げる","完遂する","遂げる"],"termString":"[Х を] 成し遂げる, やり遂げる, 完遂する, 遂げる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["亡くなる","死ぬ"],"termString":"(迂言的に) 亡くなる, 死ぬ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":582,"spelling":"зачу̂б"}]},{"e