\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"分離形","spelling":"восо̂рашше е̂ззар","pronunciation":""}],"relations":[{"titles":["合成元"],"number":1310,"spelling":"е̂лаз"},{"titles":["合成元"],"number":625,"spelling":"восо̂рашше"}]}]},{"id":"699131329874f953e6e57d5c","number":25,"spelling":"е̂к","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["ある"],"termString":"[Е′ で] ある","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"いわゆる繋辞であるが、現実の多くの言語と比べると用法が狭いことに注意せよ。\nこの単語は、主語が補語と等しいことや主語が補語の属性をもつことを表す用法のみをもつ。\n存在や所在を表す用法は [{со̂к}](@#75) が担う。","hidden":false},{"title":"語法","text":"主語が {е̂к} の後ろに置かれていて補語が体言の場合は、その補語が {а} を伴って〈{е̂к}＋主語＋{а}＋補語〉の形になることが多い。\n特に、主語が不定の場合や、疑問文で {анно̀к} が文頭に置かれている場合は、{е̂к} の主語が動詞の後に置かれるためこの形になりやすい。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["ある","起こる","開催される"],"termString":"(現象や催しなどが) ある, 起こる, 開催される","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":75,"spelling":"су̂к"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":52,"spelling":"√ҫ-ъ-к"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"697fe34957355e8c9549b3d4","number":1310,"spelling":"е̂лаз","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["芸術作品","芸術品","芸術","作品","アート","アートワーク"],"termString":"芸術作品, 芸術品, 芸術, 作品, アート, アートワーク","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1309,"spelling":"√ў-л-ӟ"},{"titles":["語型"],"number":35,"spell