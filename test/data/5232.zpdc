tles":["動詞"],"terms":["掻く"],"termString":"[Х を] 掻く","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2115,"spelling":"√ҕ-й-ш"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"69908af70b1f4a5b58f9fd70","number":1897,"spelling":"ҕасси̂д","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["話す","喋る","会話する","対話する","談話する"],"termString":"[Т と] 話す, 喋る, 会話する, 対話する, 談話する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{ҕасси̂д}](@#1897), [{шетхалу̂ффе}](@#1351)⟫\n{ҕасси̂д} と {шетхалу̂ффе} はどちらも特定の相手と会話することを表し、さらに一方的ではなく相互的に話をしていることまで含意する。\n{ҕасси̂д} は単にこの意味だけをもつが、{шетхалу̂ффе} には「楽しげである」や「他愛もない内容である」などのニュアンスが加わる。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1351,"spelling":"шетхалу̂ффе"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1896,"spelling":"√ҕ-с-д"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"}]}]},{"id":"69e828157eff507dd23ce3e4","number":2054,"spelling":"ҕасу̂д","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["交換する"],"termString":"[Х を С と Т と] 交換する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"目的語は 3 種類ある。\n対格には相手に渡すものが置かれ、与格には相手から代わりに受け取るものが置かれ、具格には交換する相手が置かれる。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":2192,"spelling":"воссу̂г"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1896,"spelling":"√ҕ-с-д"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"6978014f4c82103c1a8706cc","number":485,"spelling":"ҕафи̂","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["得る","入手する","取得する","手に入れる"],"termString":"[Х を М から] 得る, 入手する, 取得する, 手に入れる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":547,"spelling":"веҕфи̂"},{"titles":["類義語"],"number":1426,"spelling":"вецае̂т"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":484,"spelling":"√ҕ-ф-й"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"697ee699e268e2c9279268a0","number":486,"spelling":"ҕафо̂е","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["習う","教わる","学ぶ"],"termString":"[Х を М から] 習う, 教わる, 学ぶ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":484,"spelling":"√ҕ-ф-й"},{"titles":["語型"],"number":72,"spelling":"‹катө̂ппе›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"689ffbd84420597dd70c1fd7","number":837,"spelling":"ҕачу̂ж","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["つらくなる","つらく思う"],"termString":"つらくなる, つらく思う","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":836,"spelling":"√ҕ-ч-ӝ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"69fbfa5d1ca4bbbf09bc0b21","number":2359,"spelling":"ҕашҕу̂ш","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["くしゃみをする"],"termString":"くしゃみをする","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2358,"spelling":"√ҕ-ш-ҕ-ш"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"68c8af73006049e77bd68b5d","number":1167,"spelling":"ҕеди̂далло","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["銀行","バンク"],"termString":"銀行, バンク","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":9,"spelling":"√ҕ-д-л"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]}]},{"id":"696e2be6371084ef31b65b4f","number":41,"spelling":"ҕеди̂лло","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["店","商店","売店","ショップ"],"termString":"店, 商店, 売店, ショップ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":9,"spelling":"√ҕ-д-л"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]}]},{"id":"6981b2b54f437f8b935a6605","number":488,"spelling":"ҕеду̂фео","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["学校","学園","教室"],"termString":"学校, 学園, 教室","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{ҕеду̂фео}](@#488), [{хи̂сал}](@#951), [{теду̂ало}](@#243)⟫\n{ҕеду̂фео} と {хи̂сал} は、教育機関としての小学校から高校までを意味する際には、特に大きなニュアンスの違いがなく用いられる。\nしかし {ҕеду̂фео} の意味はより広く、何かを習うための学校や教室全般を全て指す。\nしたがって、手芸教室や水泳教室などのいわゆる習い事の教室も指すことがあるし、学習塾なども指し得る。\n一方で {хе̂сал} は、教育機関としての学校のみを指す。\nなお {теду̂ало} は、基本的に大学などの高等教育機関のみを指し、{ҕеду̂фео} や {хи̂сал} との意味の被りはない。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":951,"spelling":"хи̂сал"},{"titles":["類義語"],"number":243,"spelling":"теду̂ало"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":484,"spelling":"√ҕ-ф-й"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]}]},{"id":"69b3f6582f18f4b13cbe26a9","number":487,"spelling":"ҕесу̂фее","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","両類"],"terms":["生徒","学生"],"termString":"生徒, 学生","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{ҕесу̂фее}](@#487), [{хеси̂сал}](@#2067), [{тесу̂ал}](@#204)⟫\n{ҕесу̂фее}, {хеси̂сал}, {тесу̂ал} の使い分けは、{ҕеду̂фео}, {хи̂сал}, {теду̂ало} の使い分けとほぼ同じである。\n{ҕесу̂фее} はあらゆる学校や教室における生徒を指すが、{хеси̂сал} は小学校から高校までの教育機関の学生のみを表す。\nただし、日常では教育機関の学生かどうかに関わらず {ҕесу̂фее} の方が好まれる。\nまた、職業や身分としての「学生」には {хеси̂сал} が使われる。\n一方で、{тесу̂ал} は基本的に大学などの高等教育機関の学生のみを指す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":2067,"spelling":"хеси̂сал"},{"titles":["類義語"],"number":204,"spelling":"тесу̂ал"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":484,"spelling":"√ҕ-ф-й"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"},{"titles":["語型"],"number":200,"spelling":"‹-ес-›"}]}]},{"id":"689ffbda4420597dd70c2133","number":28,"spelling":"ҕефи̂далле","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["硬貨","コイン"],"termString":"硬貨, コイン","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":9,"spelling":"√ҕ-д-л"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"},{"titles":["語型"],"number":63,"spelling":"‹-еф-›"}]}]},{"id":"69c8e6e17b491573