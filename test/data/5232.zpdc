],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["対立する"],"termString":"[С と, М と] 対立する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{каде̂}](@#1796), [{кодкаху̂з}](@#1581), [{заду̂ффе}](@#1588)⟫\nこれらの単語は全て、立場や意見などが相手と異なっていたり逆だったりすることを表す。\n{каде̂}, {кодкаху̂з}, {заду̂ффе} の順で敵対性が強くなる。\n{каде̂} は単に立場や意見が異なることだけを表すが、{кодкаху̂з} は多少なりとも相手を説得させたり相手を自分と同じ立場に立たせようとする意志があることを含意し、{заду̂ффе} は積極的に相手を否定したり攻撃したりする意志まであることを含意する。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1581,"spelling":"кодкаху̂з"},{"titles":["類義語"],"number":1588,"spelling":"заду̂ффе"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1794,"spelling":"√к-д-ў"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"6918a23e069a70c18ec50002","number":1376,"spelling":"каду̂з","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["測る","計る","量る","測定する","計測する"],"termString":"[Х を] 測る, 計る, 量る, 測定する, 計測する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1375,"spelling":"√к-д-ӟ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"69fee3e3c6daf4f2c3c82c5e","number":2368,"spelling":"кае̂ж","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["縛る","括る"],"termString":"[Х を] 縛る, 括る","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1525,"spelling":"√к-ў-ӝ"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"}]}]},{"id":"69c8c10b7b49157398efbd35","number":2104,"spelling":"каи̂в"