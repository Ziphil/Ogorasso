itles":["類義語"],"number":252,"spelling":"бевсами̂м"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1330,"spelling":"√с-н-к"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"69fd8e9cdd22c5784f2c7ada","number":331,"spelling":"сао̂г","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["渡す","手渡す"],"termString":"[Х を С に] 渡す, 手渡す","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":327,"spelling":"√ҫ-ў-г"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"69fd8e82dd22c5784f2c7649","number":1288,"spelling":"сао̂х","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["成功する"],"termString":"[Х に] 成功する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":1289,"spelling":"жамму̂ҕ"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1287,"spelling":"√ҫ-й-х"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"}]}]},{"id":"6981ac234f437f8b9359b81b","number":1453,"spelling":"сару̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["治す","癒やす"],"termString":"[Х を] 治す, 癒やす","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"目的語には外傷も疾患も置かれる。","hidden":false},{"title":"類義語","text":"⟪[{сару̂т}](@#1453), [{кафу̂е}](@#1467)⟫\n{сару̂т} は傷や病気を治すことを表すが、{кафу̂е} は傷や病気を治そうと処置を行うことを表す。\nそのため、{сару̂т} は対象が治ることまで含意する (それが主な語義) が、 {кафу̂е} は対象が治ることを含意しない。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1467,"spelling":"кафу̂е"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1452,"spelling":"√ҫ-р-т"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"6933b720d2bc2d9af8c29872","number":1454,"spelling":"сару̂тез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["治る","癒える","治癒する"],"termString":"治る, 癒える, 治癒する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1452,"spelling":"√ҫ-р-т"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"69a294b9d9f0848b20b7deb3","number":53,"spelling":"сау̂к","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["作る","生む"],"termString":"[Х を М から] 作る, 生む","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{сау̂к}](@#53), [{зоху̂к}](@#664), [{ҕаву̂ц}](@#869)⟫\n{сау̂к} が「作る」の意味の最も一般的な単語であり、しばしば抽象的に「それが成立した状態にする」程度の意味でも使われる。\nこれに対して、{зоху̂к} には「新しいものを生み出す」や「芸術作品を作る」のニュアンスが加わり、{ҕаву̂ц} には「部品を組み立てる」のニュアンスが加わる。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":664,"spelling":"зоху̂к"},{"titles":["類義語"],"number":869,"spelling":"ҕаву̂ц"}]},{"equivalents":[{"titles":["動詞"],"terms":["する","変える","させる"],"termString":"[Х を Х′ に] する, 変える, させる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"〈{сау̂к} ＋ 対格名詞 **A** ＋ 対格形容詞 **B**〉 で「**A** を **B** の状態にする」の意味である。\n**B** に分詞が置かれた場合は、「**A** に **B** させる」の意味になり、「強制的にそうさせた」というニュアンスが若干加わる。\nなお、他の多くの動詞とは異なり、ここで用いられるのは不定詞ではなく分詞であることに注意せよ。","hidden":false},{"title":"類義語","text":"⟪[{сау̂к}](@#53), [{чагу̂т}](@#1657), [{наҕу̂}](@#1623)⟫\n{сау̂к} では変化することよりも変化前や変化後が何であるかに重点が置かれるが、 {чагу̂т} と {наҕу̂} は変化することに重点が置かれる。\n後者の中では、{чагу̂т} が最も一般的に「変化する」ということを表す。\n{наҕу̂} には「すっかり変わってしまう」というニュアンスがある。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1657,"spelling":"чагу̂т"},{"titles":["類義語"],"number":1623,"spelling":"наҕу̂"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":52,"spelling":"√ҫ-ъ-к"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"}]}]},{"id":"698819f8e1b31cc9571eb045","number":679,"spelling":"сау̂кез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["なる","変わる"],"termString":"[E′ に] なる, 変わる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{сау̂кез}](@#679), [{чагу̂тез}](@#1658), [{хагу̂з}](@#1625)⟫\n{сау̂кез}, {чагу̂тез}, {хагу̂з} の使い分けは、対応する他動詞である {сау̂к}, {чагу̂т}, {хагу̂} に準じる。\n[{сау̂к}](@#53) の項を参照せよ。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1658,"spelling":"чагу̂тез"},{"titles":["類義語"],"number":1625,"spelling":"наҕу̂з"}]},{"equivalents":[{"titles":["動詞"],"terms":["できる","作られる"],"termString":"[М で] できる, 作られる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"奪格目的語をとって、素材や材料を表す。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":52,"spelling":"√ҫ-ъ-к"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"68c513827418902b6f0b5193","number":1148,"spelling":"сафи̂ц","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["見せる","提示する","出す"],"termString":"[Х を С に] 見せる, 提示する, 出す","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1147,"spelling":"√ҫ-ф-