ctions":[{"equivalents":[{"titles":["小詞"],"terms":["そして","すると","そこで"],"termString":"そして, すると, そこで","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"前の節と今の節が時間的に続いている出来事であることを表し、そこに何らかの物語的な繋がりがあることを明示する。\n特に、小説等の出来事の叙述を行う文章では {са} の有無が重要になる。\n{са}  があればその前後で叙述中の時間が進んだことになるが、逆に {са} がなければそこは単なる状況説明などであって時間が進んだわけではないことになる。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"6953671baf7b480c585eb3d6","number":1536,"spelling":"саву̂р","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["進む","前進する","先に進む"],"termString":"進む, 前進する, 先に進む","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["従う","則る"],"termString":"[Х に, С に] 従う, 則る","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"目的語が指示や手続きであれば対格に置かれ、指示を出している人であれば与格に置かれる。\n後者の場合、「～の言うことに従う」のような意味になる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["続ける","進める"],"termString":"[Х を] 続ける, 進める","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語義","text":"一度中断していたことを再度始めることを表す。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":647,"spelling":"√ҫ-в-р"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"696e2acd371084ef31b5f492","number":567,"spelling":"саг","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["小詞"],"terms":["だから","なので","したがって"],"termString":"だから, なので, したがって","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"前の節からの結果を述べる。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":352,"spelling":"маг"}]}]},{"id":"689ffafb4420597dd70bd5ea","nu