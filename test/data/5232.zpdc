概念そのものに度合いの高低があると考えられるからである。\n一方、「とても走る」は {часи̂вве би̂зо̀ӈ} が普通で、{би̂зе} は副詞として用いられている。\nこれは、走るという行為に度合いの高低があるというよりは、走る距離や時間の大小に言及していると考えられるからである。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":569,"spelling":"ти̂жан"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":394,"spelling":"√б-ӟ-й"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"696def9f371084ef31b01bb6","number":1142,"spelling":"би̂зек","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["数","量","数量","分量"],"termString":"数, 量, 数量, 分量","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1143,"spelling":"чи̂кко"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":394,"spelling":"√б-ӟ-й"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":311,"spelling":"‹-ак-›"}]}]},{"id":"69cc7e94f71723b5485ca823","number":2165,"spelling":"би̂ллато","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["段","段差"],"termString":"段, 段差","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":752,"spelling":"√б-л-т"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"689ff9be4420597dd70b6ad7","number":285,"spelling":"би̂маҕ","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["下","下方"],"termString":"[М の] 下, 下方","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false},{"titles":["名詞","赤類"],"terms":["下部","下側","下"],"termString":"[Е の] 下部, 下側, 下","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variation