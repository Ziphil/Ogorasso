lents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":170,"spelling":"√ҙ-м-к"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"}]}]},{"id":"68a040d44420597dd7109515","number":636,"spelling":"зи̂ммавевепи̂нат","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["夕食","夕飯","夕ご飯","晩ご飯"],"termString":"夕食, 夕飯, 夕ご飯, 晩ご飯","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["合成元"],"number":131,"spelling":"зи̂ммаво"},{"titles":["合成元"],"number":633,"spelling":"вепи̂нат"}]}]},{"id":"689ffac84420597dd70baa9f","number":131,"spelling":"зи̂ммаво","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["夕方","夕"],"termString":"夕方, 夕","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":130,"spelling":"си̂ххас"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":128,"spelling":"√ӟ-м-в"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"69c78f4a0cc2c5efe57930b7","number":989,"spelling":"зи̂ммако","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["ゴミ","不要物","屑"],"termString":"ゴミ, 不要物, 屑","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":[],"terms":["ごみ","くず","クズ"],"termString":"ごみ, くず, クズ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true}],"informations":[{"title":"類義語","text":"⟪[{зи̂ммако}](@#989), [{ассу̂те}](@#2145), [{бе̂лло}](@#995)⟫\n{зи̂ммако} は、一般に不要になったものを表す。\nそのため、サイズの含意はなく、不要になったものであれば紙切れなども本棚なども指し得る。\n{ассу̂те} と {бе̂лло} は、不要かどうかというニュアンスは薄く、汚れとして認識されている細々としたものという意味合いが強い。\nこの両者を比較すると、{ассу̂те} の方が指す対象のサイズが大きく、{ассу̂те} は紙切れや髪の毛や糸くずなどを指すのに対し、 {бе̂лло} は埃や塵などのより細かいのものを指す。\nただし、{бе̂лло} は「床や机などに積もるもの」が原義であるため、床や机に落ちている髪の毛や糸くずなどが (その他の埃と一緒に) {бе̂лло} で指されることはある。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":2145,"spelling":"ассу̂те"},{"titles":["類義語"],"number":995,"spelling":"бе̂лло"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":170,"spelling":"√ҙ-м-к"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"693638fcd6adcf964fa6ee38","number":1477,"spelling":"зи̂нно","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["窓"],"termString":"窓","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":286,"spelling":"√з-н-ў"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"69c78fc10cc2c5efe57947f4","number":776,"spelling":"зи̂но","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["外","外部","外側"],"termString":"[М の] 外, 外部, 外側","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"定形で用いられた場合、「その場の外」の意味になる。\nこのとき、送り手や受け手が屋内にいるならば、「屋外」を意味することが多い。","hidden":false},{"title":"語法","text":"語義 B の場合とは違い、形容詞用法はない。\n「外にある」の意味では連体処格形が用いられる。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":723,"spelling":"ви̂сах"}]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["外国"],"termString":"外国","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["形容詞"],"terms":["外国の","異国の","外文化の"],"termString":"外国の, 異国の, 外文化の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":923,"spelling":"вожи̂сах"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2