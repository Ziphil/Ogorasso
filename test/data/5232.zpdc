er":1078,"spelling":"табу̂ззе"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":806,"spelling":"√с-д-ц"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":63,"spelling":"‹-еф-›"}]}]},{"id":"68b3f79eccc2dca048bb895d","number":812,"spelling":"садефу̂цез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["揺れる","ゆらゆらする"],"termString":"揺れる, ゆらゆらする","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":808,"spelling":"саду̂цез"},{"titles":["類義語"],"number":1077,"spelling":"табу̂ззез"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":806,"spelling":"√с-д-ц"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":63,"spelling":"‹-еф-›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"69648153a0ead40314e0758d","number":1699,"spelling":"саду̂ббе","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["注意する","注意を向ける","気をつける","気を配る"],"termString":"[Х に] 注意する, 注意を向ける, 気をつける, 気を配る","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":412,"spelling":"√ҫ-д-б"},{"titles":["語型"],"number":72,"spelling":"‹катө̂ппе›"}]}]},{"id":"6981abbf4f437f8b9359a885","number":807,"spelling":"саду̂ц","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["揺さぶる","揺り動かす","揺する","揺らす"],"termString":"[Х を] 揺さぶる, 揺り動かす, 揺する, 揺らす","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{саду̂ц}](@#807), [{садефу̂ц}](@#811), [{вазу̂вве}](@#1078)⟫\n{саду̂ц}, {садефу̂ц}, {вазу̂вве} は全て、対象を少し傾けてもとの状態に戻すという行為を 1 回以上行うことを表す。\n{саду̂ц} と {садефу̂ц} の違いはその勢いであり、 {садефу̂ц} の方が勢いが小さく日本語の「ゆらゆら」のイメージが近い。\nまた、{вазу̂вве} は「揺れが細かい」という意味合いが付加される。\n概ね、それぞれシャレイア語の lilted, ríles, biltik に相当する。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":811,"spelling":"садефу̂ц"},{"titles":["類義語"],"number":1078,"spelling":"табу̂ззе"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":806,"spelling":"√с-д-ц"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"6981abf14f437f8b9359b121","number":808,"spelling":"саду̂цез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["揺れる","揺れ動く"],"termString":"揺れる, 揺れ動く","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{саду̂цез}](@#808), [{садефу̂цез}](@#812), [{вазу̂ввез}](@#1077)⟫\n{саду̂цез}, {садефу̂цез}, {вазу̂ввез} の使い分けは、{саду̂ц}, {садефу̂ц}, {вазу̂вве} の使い分けに準じる。\n[{саду̂ц}](@#807) の項を参照せよ。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":812,"spelling":"садефу̂цез"},{"titles":["類義語"],"number":1077,"spelling":"табу̂ззез"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":806,"spelling":"√с-д-ц"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"69f31284d70ac6496502f7e2","number":250,"spelling":"сами̂м","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["来る","やって来る"],"termString":"[М から С へ] 来る, やって来る","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":242,"spelling":"зи̂х"}]},{"equivalents":[{"titles":["動詞"],"terms":["来る","やって来る","なる"],"termString":"(時が) 来る, やって来る, なる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{