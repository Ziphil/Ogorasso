表し、{заби̂ц} は一部の位置が変わることを表す。\n例えば「{наси̂с} をするな」という表現は、その場を離れないことだけを命令しており、例えば首を回したり足を上げたりは許すことになる。\n一方で「{заби̂ц} をするな」という表現は、一切動くことを許さず、首を回したり指を動かしたりするのも禁止するという意味になる。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":929,"spelling":"заби̂ц"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":928,"spelling":"√н-ҫ-с"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"68a1f642ec77b5a40ed7f61e","number":1007,"spelling":"наси̂тте","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["飾る","装飾する"],"termString":"[Х を Т で] 飾る, 装飾する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":539,"spelling":"√н-с-т"},{"titles":["語型"],"number":72,"spelling":"‹катө̂ппе›"}]}]},{"id":"68b40cbfccc2dca048bd5122","number":1088,"spelling":"насожу̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["脱ぐ","外す","取り外す"],"termString":"[Х を] 脱ぐ, 外す, 取り外す","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":540,"spelling":"насу̂т"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":539,"spelling":"√н-с-т"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":143,"spelling":"‹-оӝ-›"}]}]},{"id":"689ffae84420597dd70bc6a5","number":932,"spelling":"насси̂с","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["持って行く","届ける","運ぶ"],"termString":"[Х を С に М から] 持って行く, 届ける, 運ぶ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"re