.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":459,"spelling":"фетти̂чал"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":347,"spelling":"√т-ч-л"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"},{"titles":["語型"],"number":425,"spelling":"‹бо-›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"697eebb1e268e2c92793379a","number":1635,"spelling":"бохху̂з","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["謝る","詫びる","謝罪する"],"termString":"[Х を С に] 謝る, 詫びる, 謝罪する ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[{"titles":[],"expression":"бохху̂зар шес","terms":["ごめんなさい","ごめん","すみません","すいません"],"termString":"ごめんなさい, ごめん, すみません, すいません","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","text":"{шес} はしばしば省略されるが、ある方が丁寧である。\nまた、対格目的語を伴って、自分が行ってしまった過失の具体的な内容が述べられることもある。","hidden":false}],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":320,"spelling":"√к-х-ҙ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":425,"spelling":"‹бо-›"}]}]},{"id":"6a05148c5d6b59067b383ebe","number":2408,"spelling":"боцду̂с","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["定着する","浸透する","根付く"],"termString":"[Х が] 定着する, 浸透する, 根付く","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"物が目的語に置かれた場合はその存在や使用が当たり前になることを表し、行為が目的語に置かれた場合はそれをすることが当たり前になることを表す。","hidden":false},{"title":"語法","text":"特定の人や「社会」などの人が所属する範囲が主語に置かれ、定着する物や事が目的語に置かれる。\n日本語の「定着する」とは格組が逆であることに注意せよ。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":323,"spelling":"√ц-д-с"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":425,"spelling":"‹бо-›"}]}]},{"id":"69c8c16d7b49157398efe641","number":1306,"spelling":"боцни̂","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["切る","切り取る","もぎる","刈る","整える"],"termString":"[Х を] 切る, 切り取る, もぎる, 刈る, 整える","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"対象の表面側の一部分を切るなどして取り除いて、全体の量を減らしたり形を整えたりすることを表す。\n例えば、髪や爪を切ることや、羊などの毛を刈ることや、庭などの植物の剪定をすることや、もぎり式のチケットの半券部分を切り取ることなどがこれに当たる。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1228,"spelling":"жами̂ҕҕе"}]},{"equivalents":[{"titles":["動詞"],"terms":["借りる","借用する"],"termString":"[Х を М から] 借りる, 借用する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":1690,"spelling":"софу̂г"},{"titles":["対義語"],"number":2128,"spelling":"оци̂м"}]},{"equivalents":[{"titles":["動詞"],"terms":["引く，取る"],"termString":"[Х を] (カード等を束から) 引く，取る","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"カードゲームなどにおいて、カードを束から 1 枚もしくは数枚引くことを表す。\n特に、引くべきカードが決まっている場合に用いられる。\n占いなどで比較的自由にカードを選べる場合は [{тасу̂рре}](@#1490) が専ら使われる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1002,"spelling":"√ц-н-ъ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":425,"spelling":"‹бо-›"}]}]},{"id":"69800d5a57355e8c954cac19","number":1694,"spelling":"боцни̂реифу̂рашше","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["借用語","外来語"],"termString":"借用語, 外来語","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{боцни̂реифу̂рашше}](@#1694), [{вожи̂схеифу̂рашше}](@#1691)⟫\n{боцни̂реифу̂рашше} と {вожи̂схеифу̂рашше} は日常的には区別されずに使われる。\n区別される文脈では、 {боцни̂реифу̂рашше} は他言語由来だがその言語に十分同化しているものを指し、 {вожи̂схеифу̂рашше} は同化しておらず他言語の表現がそのまま使われているものを指す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1691,"spelling":"вожи̂схеифу̂рашше"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"分離形","spelling":"ифу̂рашше боцни̂р","pronunciation":""}],"relations":[{"titles":["合成元"],"number":1306,"spelling":"боцни̂"},{"titles":["合成元"],"number":45,"spelling":"ифу̂рашше"}]}]},{"id":"696b98bc0600434469d2525d","number":1744,"spelling":"боцу̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["不器用な","下手な"],"termString":"[Х が] 不器用な, 下手な","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["副詞","単純型"],"terms":["不器用に","下手に"],"termString":"不器用に, 下手に","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":108,"spelling":"и̂раф"},{"titles":["対義語"],"number":1743,"spelling":"фецу̂т"},{"titles":["対義語"],"number":108,"spelling":"и̂раф"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":11,"spelling":"√ц-ў-т"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":425,"spelling":"‹бо-›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"68c8b13f006049e77bd69fe0","number":1168,"spelling":"боҕи̂жас","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["浅い"],"termString":"浅い","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":149,"spelling":"зу̂ӈ"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":284,"spelling":"√ҕ-ж-с"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":425,"spelling":"‹бо-›"}]}]},{"id":"696ec1d5dd