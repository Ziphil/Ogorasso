:["語型"],"number":418,"spelling":"‹фе-›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"69577ba25f46242addc2f932","number":1671,"spelling":"фетбу̂з","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["切り替える","スイッチする","変える"],"termString":"[Х を] 切り替える, スイッチする, 変える","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1612,"spelling":"√т-б-ҙ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"}]}]},{"id":"69fb323eebd912ba8a56fb34","number":2347,"spelling":"фете̂в","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["上位の","上層の","親の"],"termString":"上位の, 上層の, 親の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{фете̂в}](@#2347), [{гоги̂на}](@#399)⟫\n{фете̂в} は、何らかの階層構造や上下構造においてより上の階層のものを指す。\nファイルシステムのような木構造における親要素や、段位や階級における上の階層のなどが、これに当たる。\n一方で {гоги̂на} は、何らかの段階における上の階層のものを指す以上に、複雑度や深刻度などが高いというニュアンスを含む。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":399,"spelling":"гоги̂на"},{"titles":["対義語"],"number":2348,"spelling":"боте̂в"}]},{"equivalents":[{"titles":["名詞","両類"],"terms":["上司","上長","上席"],"termString":"上司, 上長, 上席","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":2348,"spelling":"боте̂в"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1594,"spelling":"√т-ў-в"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"69fb6098ebd912ba8a5cfb4d","number":2356,"spelling":"фети̂сам","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["フード，頭巾"],"termString":"フード，頭巾","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2354,"spelling":"√т-ҫ-м"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"}]}]},{"id":"689ffbb44420597dd70bf9da","number":459,"spelling":"фетти̂чал","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","両類"],"terms":["姉","兄"],"termString":"姉, 兄","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":460,"spelling":"ботти̂чал"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":347,"spelling":"√т-ч-л"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"689ffbb44420597dd70bfa1b","number":299,"spelling":"фехта","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["前置詞"],"terms":["の上で","の上方で"],"termString":"[И] ～の上で, ～の上方で","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false},{"titles":["前置詞"],"terms":["の上へ","の上方へ"],"termString":"[С] ～の上へ, ～の上方へ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false},{"titles":["前置詞"],"terms":["の上から","の上方から"],"termString":"[М] ～の上から, ～の上方から","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":76,"spelling":"√ф-х-т"}]}]},{"id":"69eb28135e76fd30c59a5d71","number":1751,"spelling":"феххи̂ру","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["金","黄金","ゴールド"],"termString":"金, 黄金, ゴールド","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"「金製の」という形容詞用法はないことに注意せよ。\n{феххи̂ру} の形容詞用法は語義 B にあるように「金色の」の意味でのみ用いられ、「金製の」の意味では {феххи̂ру} の連体奪格形が用いられる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","青類"],"terms":["金色","黄金色"],"termString":"金色, 黄金色","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["形容詞"],"terms":["金色の","黄金色の"],"termString":"金色の, 黄金色の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1024,"spelling":"√х-р-ў"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"}]}]},{"id":"696b98980600434469d23a17","number":1743,"spelling":"фецу̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["器用な","上手な"],"termString":"[Х が] 器用な, 上手な","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["副詞","単純型"],"terms":["器用に","上手に","巧みに"],"termString":"器用に, 上手に, 巧みに","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":108,"spelling":"и̂раф"},{"titles":["対義語"],"number":1744,"spelling":"боцу̂т"},{"titles":["対義語"],"number":503,"spelling":"ӈи̂жаб"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":11,"spelling":"√ц-ў-т"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":418,"spelling":"‹фе-›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"696df7f4371084ef31b119cc","number":672,"spelling":"фецу̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["拾う","拾い上げる"],"termString":"[Х を] 拾う, 拾い上げる","ignoredPattern":"\\(.