r":1196,"spelling":"фу̂ӈал"}]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["人称"],"termString":"(文法の) 人称","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"備考","text":"フェンナ語では人称を数字で表す習慣がなく、固有の名前が存在する。\n具体的には、一人称, 二人称, 三人称のことをそれぞれ [{жаси̂бречи̂ко}](@#1092), [{моҕфи̂речи̂ко}](@#1093), [{***}](@#) と言う。\nさらに、特にフェンナ語文法においては、一人称単数と一人称複数が全く異なる人称として見なされている。\nこの文脈では、一人称単数のことを {жаси̂бречи̂ко} と呼び、一人称複数のことは [{догу̂чфечи̂ко}](@#1094) と呼ぶ。\nどの場合でも、人称について述べていることが明確な文脈では、前半の構成要素のみが用いられることもある。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":862,"spelling":"√ч-к-ў"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"694f91b08103140b94a524ed","number":1597,"spelling":"чи̂лав","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["12 分の 1"],"termString":"12 分の 1","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":94,"spelling":"√ч-л-в"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"68b41431ccc2dca048bdfe02","number":1089,"spelling":"чи̂ллаво","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["壁"],"termString":"壁","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":94,"spelling":"√ч-л-в"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"696201654582d96bc5d5beed","number":1685,"spelling":"чи̂но","pronunciation":"","tags":["単語","借用語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["中国"],"termString":"中国","ign