ан ши̂та}「1 階」と呼ばれる。\nただし、ヨーロッパの多くの国のように地階 (ground floor) を設ける文化圏の話をしているときは、その地階の上の階 (first floor) がそのまま直訳で {ги̂жан ши̂та}「1 階」と呼ばれ、わざわざ「2 階」のように言い換えられることはない。\nなお、この場合の地階は [{ву̂нцареги̂жан}](@#1044) と言う。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["族","系"],"termString":"⟨数学⟩ 族, 系","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":887,"spelling":"√г-ӝ-н"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"6912cdb3cbffae05f61078a1","number":1347,"spelling":"ги̂ззам","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["閉じた"],"termString":"(図形的に) 閉じた","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":1346,"spelling":"пи̂фас"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":277,"spelling":"√г-ӟ-м"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"6997a9ea0ed3ee4dbe2b70d8","number":398,"spelling":"ги̂на","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["大きい","大きな"],"termString":"大きい, 大きな","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"3 次元的な大きさを表す。\n2 次元的な大きさには [{хи̂над}](@#314) が使われる。\nここで、日本語の「大きい」は 2 次元的な大きさを表すこともあるので注意せよ。\n例えば、日本語の「大きい絵」という表現は自然であるが、絵は 2 次元的なものであるので、これをフェンナ語に直訳した {ну̂дац ги̂на} は不自然であり、{ну̂дац хи̂над} が自然である。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":401,"spelling":"фи̂тач"}]},{"equivalents":[{"titles":["形容詞"],"terms":["大きい","大きな","うるさい"],"termString":"(音が) 大きい, 大きな, うるさい","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":401,"spelling":"фи̂тач"}]},{"equivalents":[{"titles":["形容詞"],"terms":["大きい","大きな","高い"],"termString":"(数値が) 大きい, 大きな, 高い","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":401,"spelling":"фи̂тач"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":397,"spelling":"√г-н-ъ"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"693b5c4caa559f13f5a43f26","number":1493,"spelling":"ги̂нак","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["大きさ","体積","サイズ"],"termString":"大きさ, 体積, サイズ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["大きさ","ラウドネス"],"termString":"(音の) 大きさ, ラウドネス","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":397,"spelling":"√г-н-ъ"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":311,"spelling":"‹-ак-›"}]}]},{"id":"689ffa2b4420597dd70b9244","number":434,"spelling":"ги̂так","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["固い","堅い","硬い"],"termString":"固い, 堅い, 硬い","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":831,"spelling":"си̂ӈамме"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":306,"spelling":"√г-т-к"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"69b52c7cdc0c2066a60e28a5","number":2079,"spelling":"ги̂тарре","pronunciation":"","tags":["単語","借用語"],"sections":[{"eq