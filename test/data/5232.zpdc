"√ҫ-ў-г"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"689ffb5f4420597dd70be84f","number":413,"spelling":"су̂ддаб","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["興味深い","おもしろい"],"termString":"興味深い, おもしろい","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":412,"spelling":"√ҫ-д-б"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"6964bad8a0ead40314e4e81b","number":305,"spelling":"су̂к","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["もの","物体","物質"],"termString":"もの, 物体, 物質","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":52,"spelling":"√ҫ-ъ-к"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"69a83418ca0e299cd236e4e9","number":75,"spelling":"су̂к","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["いる","ある","存在する"],"termString":"いる, ある, 存在する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"基本的に、無標では完了相的な「存在している」という意味になる。\nまた、完結相的な「存在しない状態から存在するようになった」すなわち「現れた」の意味では {сесу̂к} などの方がよく用いられるため、{су̂к} が完結相の意味で使われるのは稀である。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1369,"spelling":"те̂в"},{"titles":["類義語"],"number":2025,"spelling":"боки̂в"}]},{"equivalents":[{"titles":["動詞"],"terms":["ある","起こる","開催される"],"termString":"(現象や催しなどが) ある, 起こる, 開催される","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{су̂к}](@#75), [{е̂к}](@#25)⟫\nこの意味を本来もつのは {су̂к} の方だが、 場所や時間等の修飾語がある場合に限り {е̂к} も用いられる。\nそのため、 {су̂к} はその現象があるかないかを問題にしているというニュアンスをもち、 {е̂к} はその現象がいつもしくはどこで起こったかを問題にしているというニュアンスをもつ。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":25,"spelling":"е̂к"}]},{"equivalents":[{"titles":["動詞"],"terms":["している","する途中である"],"termString":"[Е′ を] している, する途中である","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"主語と同格の分詞を伴って進行相を表す。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":52,"spelling":"√ҫ-ъ-к"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"69f609a9ecb74a935ed2442d","number":1919,"spelling":"су̂лаххе","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["簡単な","易しい","たやすい","容易な"],"termString":"簡単な, 易しい, たやすい, 容易な","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["副詞","K 型"],"terms":["簡単に","たやすく","容易に"],"termString":"簡単に, たやすく, 容易に","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{су̂лаххе}](@#1919), [{си̂ш}](@#1966)⟫\n「簡単」の意味合いで最も一般的なのは {су̂лаххе} であり、そのものが複雑でないために簡単だったり、関わる人の能力によって簡単だったりすることを広く表す。\n一方で {си̂ш} には、「状況が良くて簡単にできた」というニュアンスがある。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":69,"spelling":"бу̂зац"},{"titles":["類義語"],"number":1966,"spelling":"си̂ш"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"旧綴り","spelling":"ху̂надде","pronunciation":""}],"relations":[{"titles":["語根"],"number":2330,"spelling":"√ҫ-л-х"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"}]}]},{"id":"6982b069d7d80d747e0cf7d4","number":1741,"spelling":"су̂м","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["口"],"termString":"口","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"v