],"termString":"拉麺","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"旧綴り","spelling":"зи̂рсарефу̂да","pronunciation":""}],"relations":[{"titles":["合成元"],"number":1128,"spelling":"зи̂рас"},{"titles":["合成元"],"number":1408,"spelling":"фи̂тта"}]}]},{"id":"697de6a9bf5040127553656a","number":1823,"spelling":"зи̂саббе","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["物音","音"],"termString":"物音, 音","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":505,"spelling":"ри̂лад"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1640,"spelling":"√ӟ-с-б"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"}]}]},{"id":"68edbb121a32cb7e3ba7c837","number":1266,"spelling":"зи̂фал","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["Ziphil の"],"termString":"Ziphil の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1265,"spelling":"√ҙ-ф-л"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"69966ae1e2624b7a86acd71f","number":1267,"spelling":"зи̂флетту̂сар","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["ハイリア数"],"termString":"ハイリア数","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"備考","text":"ハイリア数はシャレイア語を作り始めた日を元期とする番号であり、「ハイリア」という名称も (古い時代の) シャレイア語に由来する。\nしかし、Ziphil はシャレイア語に関係しない場面でもこれを日付として常用しており、フェンナ語に関する活動においても用いている。\nそのため、フェンナ語にもこの番号を表す単語があると便利であるが、「ハイリア」という名称を用いるのはシャレイア文化を示唆しすぎるため、言語に中立的な「Ziphil の数」という語形成が採用されている。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["合成元"],"number":1266,"spelling":"зи̂фал"},{"titles":["合成元"],"number":1146,"spelling":"атту̂сар"}]}]},{"id":"69e48beab4468daf4c0dbc0a","number":1379,"spelling":"зи̂х","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["道","道のり","行き方","ルート"],"termString":"[С への] 道, 道のり, 行き方, ルート","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{зи̂х}](@#1379), [{восаззу̂х}](@#1933)⟫\n{зи̂х} は、目的地にどうやって行けば良いかの手順を表す。\nこの手順は、具体的な人や場面によらない一般的なものである。\n一方 {восаззу̂х} は、移動を伴う特定の行動において、途中で立ち寄ったり経由したりした場所を含む行程を表す。\nしたがって、その内容はより個別的になる。\nまた、最終的な目的地が定まっているとも限らない。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1933,"spelling":"восаззу̂х"}]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["手段","方法","仕方","やり方"],"termString":"[С の] 手段, 方法, 仕方, やり方","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":2258,"spelling":"зи̂хассо"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":241,"spelling":"√ҙ-ъ-х"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"69f8ae4c3ff4831eca382a37","number":242,"spelling":"зи̂х","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["行く"],"termString":"[С に М から] 行く","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"メモ","text":"不定詞をとって「～に帰着する」や「結局～する」のような用法ももたせようと考えたが、そうすると「～しに行く」なのか「結局～する」なのか区別できなくなるのでやめた。\n不定詞の格で両者を区別する方法もあるかもしれないが。","hidden":true}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":250,"spelling":"сами̂м"}]},{"equivalents":[{"titles":["動詞"],"terms":["合う","噛み合う","釣り合う"],"termString":"[Х で Т と] 合う, 噛み合う, 釣り合う","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"具格には合う対象が置かれ、これは人も物もあり得る。\n対格には、どのような様子で関係しているのかを表す形容詞が置かれる。\n例えば、{зи̂х и̂рфа} なら「良く合う」の意味になり対象によって「似合う」や「気が合う」などと訳すことができ、{зи̂х ӈи̂жба} なら「似合わない」や「気が合わない」などと訳せる。\nなお、「良く合う」の意味では {шеззи̂х} も用いられる。 ","hidden":false},{"title":"語法","text":"人と物の関係を述べる場合は、人の方が主語に置かれることが多い。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":241,"spelling":"√ҙ-ъ-х"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"69e48beab4468daf4c0dbc55","number":2258,"spelling":"зи̂хассо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["手段","方法","仕方","やり方"],"termString":"[С の] 手段, 方法, 仕方, やり方","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1379,"spelling":"зи̂х"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2049,"spelling":"√ҙ-х-ҫ"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"}]}]},{"id":"69b8a41871b0eea075ecfac4","number":2102,"spelling":"зи̂ӈко","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["データ"],"termString":"データ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":170,"spelling":"√ҙ-м-к"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"69a2b70fd9f0848b20bc35fe","number":187,"spelling":"зо̂р","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["望む","願う","したい"],"termString":"[Х を С に] 望む, 願う, したい","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"与格をとらない場合は自分がしたいことを表し、与格をとった場合はその相手にしてほしいことを表す。\nまた、与格をとらずに対格に {ку̂к} 節をとることもあり、この場合は、願う相手を特に想定せずにその内容が実現してほしいということを表す。","hidden":false},{"title":"類義語","text":"⟪[{зо̂р}](@#187), [{сеҕчи̂ж}](@#839)⟫\n{зо̂р} より {сеҕчи̂ж} の方が願望の度合いが高い。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":839,"spelling":"сеҕчи̂ж"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":186,"spelling":"√ҙ-й-р"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"69e779562491c89064a81cd1","number":2270,"spelling":"зобну̂х","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["捨てる","手放す","破棄する","廃棄する"],"termString":"[Х を] 捨てる, 手放す, 破棄する, 廃棄する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1317,"spelling":"√б-н-х"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":291,"spelling":"‹зо-›"}]}]},{"id":"69d63b751ab066193611bdc3","number":2195,"spelling":"зоги̂ззах","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["砂浜","ビーチ"],"termString":"砂浜, ビーチ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1574,"spelling":"√ӟ-ӟ-х"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"},{"titles":["語型"],"number":64,"spelling":"‹-ог-›"}]}]},{"id":"698065ae57355e8c95526bf3","number":622,"spelling":"зоди̂маццо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["休日","休み"],"termString":"休日, 休み","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{зоди̂маццо}](@#622), [{зохди̂вто}](@#623)⟫\n{зоди̂маццо} は暦上の休日を表し、{зохди̂вто} は個々人の仕事等の休みの日を表す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":623,"spelling":"зохди̂вто"},{"titles":["対義語"],"number":1783,"spelling":"жоде̂со"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":594,"spelling":"√з-м-ц"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"},{"titles":["語型"],"number":433,"spelling":"‹-од-›"}]}]},{"id":"693f6dfaf2aa5984aeb280ba","number":1515,"spelling":"зожи̂дах","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["連述詞"],"terms":["以下"],"termString":"以下","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1514,"spelling":"ми̂ццак"},{"titles":["対義語"],"number":1516,"spelling":"можи̂ццак"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1411,"spelling":"√ҙ-д-х"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":143,"spelling":"‹-оӝ-›"}]}]},{"id":"69b6a92addf85d5456e08160","number":2091,"spelling":"зозау̂ӈ","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["掘り出す","掘り起こす","発掘する","採掘する"],"termString":"[Х を] 掘り出す, 掘り起こす, 発掘する, 採掘する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2083,"spelling":"√ӟ-ъ-ӈ"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"},{"titles":["語型"],"number":291,"spelling":"‹зо-›"}]}]},{"id":"689ffaca4420597dd70bacd6","number":330,"spelling":"зозбу̂ц","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"