":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["名詞類","類","名詞性","性","名詞クラス"],"termString":"名詞類, 類, 名詞性, 性, 名詞クラス","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語義","text":"フェンナ語における名詞が赤類と青類の 2 つに分類されることから、フェンナ語の文法用語である「類」を表す。\nここから派生して、一般に「名詞性」や「名詞クラス」の意味でも用いられる。\nこの意味ではもはや「二項分類のどちらであるか」の意味合いは薄れており、言及している言語に名詞クラスが 3 つ以上あったとしても、この単語が用いられる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["真偽値","ブール値"],"termString":"真偽値, ブール値","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false},{"titles":["形容詞"],"terms":["真偽値の","ブール値の"],"termString":"真偽値の, ブール値の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":162,"spelling":"√д-ч-ф"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"}]}]},{"id":"69f5bb78ecb74a935ec566d3","number":943,"spelling":"ду̂чфехефи̂лад","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["半袖"],"termString":"半袖","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"メモ","text":"実際に「半袖」と呼ばれているものには袖の長さが腕の半分より短いものも多いが、個人的には腕の半分くらいある (肘くらいまである) 袖が好きなので、日本語と同じく「半分」との合成語として造語した。\n","hidden":true}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":942,"spelling":"шу̂техефи̂лад"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"分離形","spelling":"хефи̂лад ду̂чаф","pronunciation":""},{"title":"旧綴り","spelling":"ду̂чфеӈи̂латте","pronunciation":""}],"relations":[{"titles":["合成元"],"number":163,"spelling":"ду̂чаф"},{"titles":["合成元"],"number":941,"spelling":"хефи̂лад"}]}]},{"id":"689ffabc4420597dd70b9e0d","number":164,"spelling":"ду̂ччаф","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["6 個","6 人","6 つ"],