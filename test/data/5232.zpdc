mber":57,"spelling":"‹аккө̂тап›"}]}]},{"id":"6901fd77986a95339e159c0e","number":1321,"spelling":"ацци̂ссо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["尻","お尻","臀部","ヒップ"],"termString":"尻, お尻, 臀部, ヒップ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":323,"spelling":"√ц-д-с"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"}]}]},{"id":"69e827467eff507dd23cd2ba","number":2272,"spelling":"аццожи̂на","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["明らかでない","明白でない","非自明な"],"termString":"明らかでない, 明白でない, 非自明な","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":2269,"spelling":"ацци̂на"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1002,"spelling":"√ц-н-ъ"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"},{"titles":["語型"],"number":143,"spelling":"‹-оӝ-›"}]}]},{"id":"6980097457355e8c954c4b8d","number":466,"spelling":"аччаҕи̂с","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["育てる","養育する"],"termString":"[Х を] 育てる, 養育する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{аччаҕи̂с}](@#466), [{шетаччаҕи̂с}](@#467), [{цаӈу̂к}](@#783)⟫\n{аччаҕи̂с} と {шетаччаҕи̂с} はともに対象を育てることを表すが、{шетаччаҕи̂с} の方には対象への愛情があるというニュアンスが加わる。\nまた、{аччаҕи̂с} は自分自身の子供, 家畜, 植物など様々な対象を目的語にとるが、{шетаччаҕи̂с} は基本的には猫のような愛玩動物のみを目的語にとる。\n{цаӈу̂к} は、特に作物や家畜などを農業として育てることのみを指す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":467,"spelling":"шетаччаҕи̂с"},{"titles":["類義語"],"number":783,"spelling":"цаӈу̂к"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":207,"spelling":"√ч-ҕ-с"},{"titles":["語型"],"number":73,"spelling":"‹аккатө̂п›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"698009b757355e8c954c5a88","number":483,"spelling":"аччаҕи̂сез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["育つ","成長する"],"termString":"育つ, 成長する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{аччаҕи̂сез}](@#483), [{гани̂}](@#482)⟫\n{аччаҕи̂сез} は成熟のニュアンスが強い一方で、{гани̂} は単に体が大きくなったことが注目される。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":482,"spelling":"гани̂"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":207,"spelling":"√ч-ҕ-с"},{"titles":["語型"],"number":73,"spelling":"‹аккатө̂п›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"69902b940b1f4a5b58e9404b","number":56,"spelling":"ашши̂лах","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["白","白色"],"termString":"白, 白色","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["形容詞"],"terms":["白い","白色の"],"termString":"白い, 白色の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":54,"spelling":"√ш-л-х"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"}]}]},{"id":"697fe76157355e8c954a3961","number":659,"spelling":"ашши̂лхови̂вхо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["白ワイン"],"termString":"白ワイン","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[{"title":"分離形","spelling":"ви̂вхо ашши̂лхо","pronunciation":""}],"relations":[{"titles":["合成元"],"number":56,"spelling":"ашши̂лах"},{"titles":["合成元"],"number":535,"spelling":"ви̂вхо"}]}]},{"id":"693c1550aa559f13f5b3de83","number":1497,"spelling":"ашшу̂та","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["一般的な","一般論の"],"termString":"一般的な, 一般論の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false},{"titles":["副詞","K 型"],"terms":["一般に","一般的に","総じて","概して"],"termString":"一般に, 一般的に, 総じて, 概して","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":155,"spelling":"√ш-т-ъ"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"}]}]},{"id":"689ff9b94420597dd70b658c","number":870,"spelling":"аҕҕаву̂ц","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["料理する","調理する"],"termString":"[Х を] 料理する, 調理する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"対格には、完成品も材料も置かれ得る。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":868,"spelling":"√ҕ-в-ц"},{"titles":["語型"],"number":73,"spelling":"‹аккатө̂п›"}]}]},{"id":"689ff9b94420597dd70b65bc","number":953,"spelling":"аҕҕеду̂вцо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["キッチン","台所","お勝手","調理場","炊事場","厨"],"termString":"キッチン, 台所, お勝手, 調理場, 炊事場, 厨","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":868,"spelling":"√ҕ-в-ц"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]}]},{"id":"689ff9b94420597dd70b65f2","number":886,"spelling":"аҕҕесу̂вац","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","両類"],"terms":["料理人","シェフ","コック","板前"],"termString":"料理人, シェフ, コック, 板前","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"対格には、完成品も材料も置かれ得る。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":868,"spelling":"√ҕ-в-ц"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"},{"titles":["語型"],"number":200,"spelling":"‹-ес-›"}]}]},{"id":"6944c157960af9c4b391cc5d","number":1535,"spelling":"аҕҕи̂лаз","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["公式の","公認の"],"termString":"公式の, 公認の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":737,"spelling":"√ҕ-л-з"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"}]}]},{"id":"6989c4521b8975226a5a8819","number":871,"spelling":"аҕҕу̂вац","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["料理"],"termString":"料理","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{аҕҕу̂вац}](@#871), [{ти̂ннас}](@#1878)⟫\n{аҕҕу̂вац} は一般に料理全般を指すが、 {ти̂ннас} は皿に盛り付けられた 1 品を指す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1878,"spelling":"ти̂ннас"},{"titles":["類義語"],"number":552,"spelling":"си̂ам"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":868,"spelling":"√ҕ-в-ц"},{"titles":["語型"],"number":57,"spelling":"‹аккө̂тап›"}]}]},{"id":"6943cc39960af9c4b382b6a1","number":873,"spelling":"бав","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["小詞"],"terms":["両方"],"termString":"両方","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[{"title":"語法","text":"典型的には、語句を繋げる {и} とともに用いられ、*A* {ибав} *B* で「*A* と *B* の両方」や「*A* も *B* も」の意味になる。\nこの {ибав} は 3 個以上の語句を繋げることもあり、 *A* {ибав} *B* {ибав} *C* は「*A* も *B* も *C* も全部」の意味である。\n\nなお、節に対して用いられる場合もあり、直前の節とその節の両方が成り立つことを強調する。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"698009ea57355e8c954c5e05","number":427,"spelling":"бавви̂с","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["もう一度やる","繰り返す","反復する"],"termString":"[Х を] もう一度やる, 繰り返す, 反復する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{бавви̂с}](@#427), [{бевви̂д}](@#1518)⟫\n{бавви̂с} は単に同じことをもう一度行うことを表すのみだが、{бевви̂д} には「失敗したのでやり直す」というニュアンスがある。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1518,"spelling":"бевви̂д"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":157,"spelling":"√б-в-ҫ"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"}]}]},{"id":"69f0168545269b763dcb6e25","number":1222,"spelling":"баву̂с","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["コピーする","複製する"],"termString":"[Х を] コピーする, 複製する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{баву̂с}](@#1222), [{бевгажи̂н}](@#1221), [{фели̂ц}](@#2293)⟫\n{баву̂с} と {бевгажи̂н} はほぼ同じ意味で用いられるが、 {баву̂с} の方が「全く同じ複製を作る」というニュアンスが強く、一方で {бевгажи̂н} は「形式等は違えど同じものを作る」というニュアンスに成ることが多い。\nコンピュータの文脈では、{баву̂с} は即座に全く同じ内容のデータをもう 1 つ作ることを表し、{бевгажи̂н} はクリップボードにデータをコピーするだけのことを表す。\n{фели̂ц} は、これら 2 者と比べて「同じものを作る」という意味がさらに弱まっており、内容や形式が概ね同じものを作ることを広く表す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1221,"spelling":"бевгажи̂н"},{"titles":["類義語"],"number":2293,"spelling":"фели̂ц"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":157,"spelling":"√б-в-ҫ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"6984fef997a174bdaeeaac30","number":1857,"spelling":"баву̂сак","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["コピー","複製"],"termString":"コピー, 複製","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":157,"spelling":"√б-в-ҫ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":311,"spelling":"‹-ак-›"}]}]},{"id":"69de29cca6ff07c100811cb3","number":1638,"spelling":"баги̂с","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["折る"],"termString":"[Х を] 折る ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["曲がる"],"termString":"[С に] (方向を) 曲がる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":12,"spelling":"цу̂т"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1637,"spelling":"√б-г-с"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"699933f250caccf10f247234","number":1645,"spelling":"баду̂дде","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["殴る","殴打する","パンチする"],"termString":"[Х を] 殴る, 殴打する, パンチする","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1559,"spelling":"√б-д-д"},{"titles":["語型"],"number":72,"spelling":"‹катө̂п