{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":251,"spelling":"‹бева-›"}]}]},{"id":"698e7bcd3aa998141bd38fc4","number":1361,"spelling":"бевнасу̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["着替える"],"termString":"[Х を М から С に] 着替える","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":539,"spelling":"√н-с-т"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":251,"spelling":"‹бева-›"}]}]},{"id":"699d55784da6db8221b2687f","number":1297,"spelling":"беври̂ццал","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["二重丸","二重円"],"termString":"二重丸, 二重円","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"円の中に別の小さい円が配置されている図形を表す。\n語義 B の通りフェンナ語のシンボルを指す場合を除き、2 つの円が重なっている図形を一般に指すことはない。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["双円","レベヴリーツァル"],"termString":"双円, レベヴリーツァル","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"備考","text":"2 つの円が左右に重なるように配置され、左側の円に垂直に線が貫いている図形である。\n左右の円はそれぞれ「精神」と「理性」を象徴しており、それが 2 つ重なったこの図形は「全体性」や「無限」を表す記号である。\nそのため、あらゆる記録や創作が収められた大図書館の存在を信じる大図書館信仰において、その大図書館や信仰そのものを象徴するシンボルとしても用いられている。\nさらに、2 つの円が {фи̂нна} 「フェンナ」 と {о̂рашше} 「言語」の頭文字にも偶然見えることから、フェンナ語を象徴するシンボルとしても用いられている。\n","hidden":false},{"title":"語法","text":"この意味では常に定形で現れる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":176,"spelling":"√р-ц-л"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"},{"titles":["語型"],"number":251,"spelling":"‹бева-›"}]}]},{"id":"69f830dd3ff4831eca2ae095","number":1219,"spelling":"бевр