lents":[{"titles":["名詞","両類"],"terms":["王妃","妃","后","王配","王婿","国婿"],"termString":"王妃, 妃, 后, 王配, 王婿, 国婿","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"王 (もしくは女王) の配偶者を表す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1949,"spelling":"ферфу̂цал"}]},{"equivalents":[{"titles":["名詞","赤類"],"terms":["クイーン"],"termString":"⟨カード⟩ クイーン","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1950,"spelling":"√ӟ-д-н"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"},{"titles":["語型"],"number":63,"spelling":"‹-еф-›"}]}]},{"id":"69c5dde62c4f1d295655a86b","number":2139,"spelling":"зефу̂хсо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["お手洗い","手洗い場","洗面所","トイレ"],"termString":"お手洗い,  手洗い場, 洗面所, トイレ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{зефу̂хсо}](@#2139), [{зочду̂змо}](@#2138)⟫\n「トイレ」の意味では、{зефу̂хсо} の方が日常では頻繁に用いられる。\n{зочду̂змо} には少し直接的もしくはフォーマルな印象がある。\nまた、「トイレに行く」の意味では、直訳的な {зи̂х зефу̂хсос} の他にも [{зонцу̂к}](@#900) が使われることもある。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":2138,"spelling":"зочду̂змо"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2049,"spelling":"√ҙ-х-ҫ"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":63,"spelling":"‹-еф-›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"69accc75697a656297c8d3c9","number":543,"spelling":"зеффу̂н","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["優しくする","親切にする"],"termString":"[С に] 優しくする, 親切にする","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["分詞"],"terms":["優しい","親切な"],"termString":"[С に] 優しい, 親切な","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":191,"spelling":"√й-ф-н"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"},{"titles":["語型"],"number":291,"spelling":"‹зо-›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"699e536d8d72ea956b94640d","number":1958,"spelling":"зешу̂чбо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["死神"],"termString":"死神","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"備考","text":"フェンナ文化においては、死とは精神が肉体から脱して自由になる現象だと考えられている。\nそのため、「死が迎えに来る」といった考えもあまり生まれず、死が強くネガティブに捉えられることもなかったため、死の擬人化が行われる伝統はない。\nしたがって、死神はフェンナ文化に根ざしたものではなく、外来文化として取り入れられた概念である。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":580,"spelling":"√ӟ-ч-б"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":670,"spelling":"‹-еш-›"}]}]},{"id":"6a0b1664583500c531cd7fc4","number":2390,"spelling":"зи̂аз","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["ザラザラした","粗い"],"termString":"ザラザラした, 粗い","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":[],"terms":["ざらざらした"],"termString":"ざらざらした","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":1966,"spelling":"си̂ш"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":2197,"spelling":"√ӟ-ъ-ҙ"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"}]}]},{"id":"694cb3053b866d9e63627b23","number":206,"spelling":"зи̂баццо","pronunciation":"","tags":["単語"],"section