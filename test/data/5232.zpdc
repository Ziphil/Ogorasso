"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["苦労する","苦心する","骨を折る"],"termString":"苦労する, 苦心する, 骨を折る","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":68,"spelling":"√б-ӟ-ц"},{"titles":["語型"],"number":71,"spelling":"‹каттө̂п›"}]}]},{"id":"689ff9bb4420597dd70b67b4","number":403,"spelling":"бази̂","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["増やす","増加させる"],"termString":"[Х を] 増やす, 増加させる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":404,"spelling":"дачогу̂ф"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":394,"spelling":"√б-ӟ-й"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"68d79ce578fa24b9f0a96577","number":1190,"spelling":"бази̂з","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["増える","増加する"],"termString":"増える, 増加する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":394,"spelling":"√б-ӟ-й"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"689ff9bb4420597dd70b67e5","number":396,"spelling":"бал","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["小詞"],"terms":["さらに","その上","加えて"],"termString":"さらに, その上, 加えて","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]}]},{"id":"689ff9bc4420597dd70b6831","number":754,"spelling":"балу̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["踏む","踏みつける"],"termString":"[Х を] 踏む, 踏みつける","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":752,"spelling":"√б-л-т"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"68a7a69dd27058fa44364d4f","number":799,"spelling":"бамѐ","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["私たちの"],"termString":"私たちの","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false},{"titles":[],"terms":["私達の"],"termString":"私達の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":true}],"informations":[],"phrases":[],"variations":[],"relations":[]}]},{"id":"69800ab057355e8c954c6771","number":558,"spelling":"бами̂ҕ","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["降りる","下りる","下る"],"termString":"[Х を] 降りる, 下りる, 下る","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{бами̂ҕ}](@#558), [{бонси̂с}](@#560)⟫\n{бами̂ҕ} と {бонси̂с} の使い分けは、それぞれの対義語である {фахи̂т} と {фенси̂с} に準じる。\n[{фахи̂т}](@#557) を参照せよ。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":557,"spelling":"фахи̂т"},{"titles":["類義語"],"number":560,"spelling":"бонси̂с"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":147,"spelling":"√б-м-ҕ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"691267abcbffae05f608bcc0","number":652,"spelling":"баму̂ҕҕе","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["落とす","落下させる"],"termString":"[Х を С に] 落とす, 落下させる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":147,"spelling":"√б-м-ҕ"},{"titles":["語型"],"number":72,"spelling":"‹катө̂ппе›"}]}]},{"id":"69b7ab5d71b0eea075da7b8d","number":714,"spelling":"баму̂ҕҕез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["落ちる","落下する"],"termString":"[С に] 落ちる, 落下する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["結局する","落ち着く"],"termString":"[С を] 結局する, 落ち着く","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"紆余曲折を経て最終的に起こったことや行ったことを表す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":324,"spelling":"цаду̂с"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":147,"spelling":"√б-м-ҕ"},{"titles":["語型"],"number":72,"spelling":"‹катө̂ппе›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"69a4e80feda8d27226874685","number":1318,"spelling":"бану̂х","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["投げる"],"termString":"[Х を С に] 投げる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{бану̂х}](@#1318), [{сехлу̂ф}](@#709)⟫\n{бану̂х} は物を投げる行為全般を指すが、{сехлу̂ф} は特に放物線状に優しく投げることを表す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":709,"spelling":"сехлу̂ф"}]},{"equivalents":[{"titles":["動詞"],"terms":["無駄遣いする","浪費する","乱費する"],"termString":"[Х を] 無駄遣いする, 浪費する, 乱費する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1317,"spelling":"√б-н-х"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"68a7aa3cd27058fa44369183","number":1030,"spelling":"бати̂ч","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["当てる","ぶつける"],"termString":"[Х を С に] 当てる, ぶつける","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1029,"spelling":"√б-т-ч"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"68bd9faf3dcffea907478a62","number":1031,"spelling":"бати̂чез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["当たる","ぶつかる"],"termString":"[С に] 当たる, ぶつかる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["偶然遭遇する","偶然出くわす","する目に遭う"],"termString":"[С に] (出来事に) 偶然遭遇する, 偶然出くわす, する目に遭う","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1029,"spelling":"√б-т-ч"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"69800b6057355e8c954c75fd","number":1292,"spelling":"бахи̂з","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["勝つ","勝利する"],"termString":"[С に Т で] 勝つ, 勝利する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{бахи̂з}](@#1292), [{кодфахи̂т}](@#1295), [{веҕфи̂}](@#547)⟫\n{бахи̂з} と {кодфахи̂т} は、どちらも広く「勝つ」を意味する。\n一方 {веҕфи̂} は、何度も試合をやった結果として、大会などのより大きな枠組みで勝利することを表す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1295,"spelling":"кодфахи̂т"},{"titles":["類義語"],"number":547,"spelling":"веҕфи̂"},{"titles":["対義語"],"number":1296,"spelling":"кодбами̂ҕ"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1291,"spelling":"√б-х-ҙ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"69c781880cc2c5efe5780922","number":995,"spelling":"бе̂лло","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["埃","塵"],"termString":"埃, 塵","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":989,"spelling":"зи̂ммако"},{"titles":["類義語"],"number":2145,"spelling":"ассу̂те"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":992,"spelling":"√ў-с-л"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":425,"spelling":"‹бо-›"},{"titles":["語型"],"number":196,"spelling":"‹=и›"}]}]},{"id":"697eea0fe268e2c92793054e","number":263,"spelling":"бе̂мме","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","両類"],"terms":["私たち"],"termString":"私たち","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":[],"terms":["私達"],"termString":"私達","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true}],"informations":[{"title":"語法","text":"類は話者に合わせる。\nすなわち、話者が赤類であれば、それ以外に青類の人が何人いようと、話者とその人たち全体を指す {бе̂мме} は赤類形になる。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"69f830d73ff4831eca2adf62","number":1218,"spelling":"беббоди̂жжамо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["残暑"],"termString":"残暑","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"夏や秋から冬になる時期において、一度涼しくなった後に再び暑くなった日や時期を表す。\nしたがって、日本語の訳語として「残暑」を当てているが、「残暑」とは少し異なる概念である。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":209,"spelling":"√б-ӝ-м"},{"titles":["語型"],"number":7,"s