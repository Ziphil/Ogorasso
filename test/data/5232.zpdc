[{"titles":["名詞","赤類"],"terms":["地域","地帯","リージョン","エリア"],"termString":"地域, 地帯, リージョン, エリア","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":94,"spelling":"√ч-л-в"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]}]},{"id":"69feeb25c6daf4f2c3c99370","number":428,"spelling":"чел","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["前置詞"],"terms":["のために"],"termString":"[С] ～のために","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["前置詞"],"terms":["のせいで","のゆえに"],"termString":"[М] ～のせいで, ～のゆえに","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"原義は利益の授受である。\n与格もしくは奪格の表現とともに用いられるが、どちらの場合であっても、名詞を伴うことも不定詞や {ку̂к} 節を伴うこともある。\n与格名詞とともに用いられた場合は受益者を表し、与格の不定詞や {ку̂к} 節とともに用いられた場合は目的や目標を表す。\n奪格名詞とともに用いられた場合は原因となったものを表し、奪格の不定詞や {ку̂к} 節とともに用いられた場合は原因の行為や出来事を表す。\nともに、単なる原因というよりは、被害や迷惑のニュアンスが加わる。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"689ffbca4420597dd70c1346","number":208,"spelling":"чесу̂ҕҕас","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","両類"],"terms":["教師","教員","先生"],"termString":"教師, 教員, 先生","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":207,"spelling":"√ч-ҕ-с"},{"titles":["語型"],"number":7,"spelling":"‹кө̂ттап›"},{"titles":["語型"],"number":200,"spelling":"‹-ес-›"},{"titles":["語型"],"number":197,"spelling":"‹=у›"}]}]},{"id":"689ffbca4420597dd70c1383","number":384,"spelling":"чефи̂ҕас","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["印","記号","符号","シンボル","マーク"],"termString":"[Х の] 印, 