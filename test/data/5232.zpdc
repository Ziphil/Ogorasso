:["語型"],"number":290,"spelling":"‹ве-›"}]}]},{"id":"69a2c4bcd9f0848b20bdb8c2","number":2014,"spelling":"веди̂зое","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["熟練した","ベテランの"],"termString":"熟練した, ベテランの","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1925,"spelling":"веги̂жан"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1551,"spelling":"√д-ӟ-ў"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"}]}]},{"id":"689ffa1f4420597dd70b8215","number":495,"spelling":"веди̂сак","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["紙"],"termString":"紙","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":13,"spelling":"√д-с-к"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":290,"spelling":"‹ве-›"}]}]},{"id":"69eeca762fbf986373f5c126","number":631,"spelling":"веди̂сар","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["今","現在"],"termString":"今, 現在","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":["形容詞"],"terms":["今の","現在の"],"termString":"今の, 現在の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{е̂ддо}](@#616), [{веди̂сро}](@#631)⟫\n「今」の意味では {е̂ддо} の方がよく用いられるが、{веди̂сро} にはさらに強調のニュアンスがある。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":616,"spelling":"е̂ддо"}]},{"equivalents":[{"titles":["副詞","K 型"],"terms":["ちょうど","ちょうど今","今まさに"],"termString":"ちょうど, ちょうど今, 今まさに","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"この意味では、時間の含意はなく、動作まさにそのとき完了したことを意味する。\nそのため、過去時制とも共起する。\nまた、完了の意味をもつことから、{зале̂} による完了相表現を伴わなくても完了の意味になり、そのためわざわざ完了相表現が使われることも少ない。\n逆に、進行相の意味になることはなく、「今まさに～している」の意味では語義 A が処格で用いられる。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":630,"spelling":"√д-ҫ-р"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":290,"spelling":"‹ве-›"}]}]},{"id":"69363b52d6adcf964fa71e55","number":1478,"spelling":"веду̂сах","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","赤類"],"terms":["入口","エントランス"],"termString":"入口, エントランス","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["対義語"],"number":1479,"spelling":"зеду̂но"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":288,"spelling":"√в-ҫ-х"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]}]},{"id":"69ae2d4fff6bee0e7c63c2a0","number":2045,"spelling":"веду̂се","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["形容詞"],"terms":["中くらいの","中程度の"],"termString":"(程度が) 中くらいの, 中程度の","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":[],"terms":["中ぐらいの"],"termString":"中ぐらいの","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true},{"titles":["連述詞"],"terms":["中くらい","中程度に"],"termString":"中くらい, 中程度に","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false},{"titles":[],"terms":["中ぐらい"],"termString":"中ぐらい","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":true}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1884,"spelling":"√в-ҫ-й"},{"titles":["語型"],"number":35,"spelling":"‹кө̂тап›"},{"titles":["語型"],"number":65,"spelling":"‹-ед-›"}]