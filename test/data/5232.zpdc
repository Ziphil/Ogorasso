],"number":72,"spelling":"‹катө̂ппе›"},{"titles":["語型"],"number":1442,"spelling":"‹гоба-›"}]}]},{"id":"69b2172fc3f887a6006eab26","number":2064,"spelling":"гобли̂кассо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["夜明け","早朝","翌朝"],"termString":"夜明け, 早朝, 翌朝","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"その日の夜が明けた後の次の日の早朝を指す。\nその日の過ぎ去った朝を指すことはない。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":119,"spelling":"√л-к-с"},{"titles":["語型"],"number":24,"spelling":"‹кө̂тaппе›"},{"titles":["語型"],"number":1442,"spelling":"‹гоба-›"}]}]},{"id":"696b595e0600434469c5c2d3","number":1739,"spelling":"гобнасу̂т","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["異性装する","女装する","男装する"],"termString":"異性装する, 女装する, 男装する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語義","text":"周りから普段着ると思われている服装ではない服装を一時的にすることを表す。\n男性がスカートを履いたり、大人が子供服を着たりなど、社会的な慣習から外れた服装をすることを意味することもあれば、普段は地味な服装しかしないような人が派手な服装をするなど、単に個人的な慣習から外れた服装をすることも表し得る。\nしたがって、英語の「cross-dressing」や日本語の「異性装」よりはかなり意味が広い。","hidden":false}],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":539,"spelling":"√н-с-т"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"},{"titles":["語型"],"number":1442,"spelling":"‹гоба-›"}]}]},{"id":"69e03ada60f7790b751d69c9","number":2243,"spelling":"гобри̂ддо","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["ラジオ"],"termString":"ラジオ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":407,"spelling":