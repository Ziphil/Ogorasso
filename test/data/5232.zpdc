rn":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"語法","text":"この単語自身に特に意味はなく、語調を整えるために挿入される。\n特に口語では、連結詞と一体となった {и́та} の形でよく用いられ、単に自分が話し始めることをそれとなく伝えるために文頭で使われたり、フィラーとして表れたりする。","hidden":false}],"phrases":[],"variations":[],"relations":[]}]},{"id":"6981aeae4f437f8b9359eff7","number":1613,"spelling":"табу̂з","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["瞬きする","瞬く"],"termString":"瞬きする, 瞬く","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[]},{"equivalents":[{"titles":["動詞"],"terms":["点滅する","明滅する","瞬く"],"termString":"(光などが) 点滅する, 明滅する, 瞬く","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{табу̂з}](@#1613), [{беттабу̂з}](@#1614)⟫\n{табу̂з} は 1 回もしくは数回だけ光が消えたり光ったりすることを表し、{беттабу̂з} は一定の期間ずっと明滅を繰り返していることを表す。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1614,"spelling":"беттабу̂з"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1612,"spelling":"√т-б-ҙ"},{"titles":["語型"],"number":5,"spelling":"‹катө̂п›"}]}]},{"id":"697f452ae268e2c9279b35d3","number":809,"spelling":"табу̂ззалоз","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["名詞","青類"],"terms":["地震"],"termString":"地震","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["同義語"],"number":814,"spelling":"ву̂нцотабу̂ззалоз"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1612,"spelling":"√т-б-ҙ"},{"titles":["語型"],"number":72,"spelling":"‹катө̂ппе›"},{"titles":["語型"],"number":1074,"spelling":"‹-ал-›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"697f452fe268e2c9279b3762","number":1078,"spelling":"табу̂ззе","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["震わせる","震わす","振動させる"],"termString":"[Х を] 震わせる, 震わす, 振動させる ","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"メモ","text":"他動詞の「震わせる」を使うことはあまりない気がするので、自動詞の「震わせる」をこの基本形に割り当てた方が自然かとも思った。\nしかし、類義語の {садо̂ц} 「揺らす」に合わせて、他動詞を基本形にした。","hidden":true}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":807,"spelling":"саду̂ц"},{"titles":["類義語"],"number":811,"spelling":"садефу̂ц"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1612,"spelling":"√т-б-ҙ"},{"titles":["語型"],"number":72,"spelling":"‹катө̂ппе›"}]}]},{"id":"697f4534e268e2c9279b38cb","number":1077,"spelling":"табу̂ззез","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["震える","振動する"],"termString":"震える, 振動する","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":808,"spelling":"саду̂цез"},{"titles":["類義語"],"number":812,"spelling":"садефу̂цез"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"number":1612,"spelling":"√т-б-ҙ"},{"titles":["語型"],"number":72,"spelling":"‹катө̂ппе›"},{"titles":["語型"],"number":70,"spelling":"‹-ҙ›"}]}]},{"id":"69a0f241b90b23af41ac5f20","number":268,"spelling":"таду̂","pronunciation":"","tags":["単語"],"sections":[{"equivalents":[{"titles":["動詞"],"terms":["できる","可能である","可能になる"],"termString":"[Х が] できる, 可能である, 可能になる","ignoredPattern":"\\(.*?\\)|\\[.*?\\]|⟨.*?⟩|～","hidden":false}],"informations":[{"title":"類義語","text":"⟪[{таду̂}](@#268), [{заду̂н}](@#1983)⟫\n{таду̂} は、一般に何かができることを表し、特にそのときの状況が良かったために可能だというニュアンスがある。\n一方 {заду̂н} は、本人にそれを行う能力があったために可能だというニュアンスが強い。","hidden":false}],"phrases":[],"variations":[],"relations":[{"titles":["類義語"],"number":1983,"spelling":"заду̂н"}]},{"equivalents":[],"informations":[],"phrases":[],"variations":[],"relations":[{"titles":["語根"],"n